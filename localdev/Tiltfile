# Homelab Local Development Environment - Tiltfile
# Last updated: 2026-09-12 (issue #261 Section B: Kind + ArgoCD loop)
#
# Two modes:
#   direct:  Tilt installs a few Helm charts straight into Kind (fastest
#            iteration on a single chart; no ArgoCD).
#   argocd:  Tilt wraps the Taskfile loop — `task localdev:argocd` installs
#            ArgoCD + the root Application, `task localdev:sync` pushes the
#            working tree into every Application (argocd app sync --local) and
#            re-runs whenever ../charts or ../configuration change,
#            `task localdev:wait` (manual) blocks until everything is Healthy.
#
# Usage (run from this directory, or `task localdev:tilt` / `task localdev:tilt:argocd`):
#   tilt up                      # direct mode (default)
#   tilt up -- --mode=argocd     # ArgoCD mode
#   TILT_MODE=argocd tilt up     # same, via the environment
#   tilt down                    # tear down Tilt-managed resources
#
# Prerequisite for both modes: the Kind cluster (task localdev:kind).

# ============================================================================
# Load Extensions
# ============================================================================

load('ext://helm_resource', 'helm_resource', 'helm_repo')

# ============================================================================
# Configuration
# ============================================================================

# `tilt up -- --mode=argocd` (Tiltfile args) wins; TILT_MODE is the fallback so
# CI and shell aliases can pick the mode without touching the command line.
config.define_string("mode", args=False, usage="direct (default) or argocd")
cfg = config.parse()
mode = cfg.get("mode", os.getenv("TILT_MODE", "direct"))
if mode not in ["direct", "argocd"]:
    fail("unknown mode %r: use --mode=direct or --mode=argocd" % mode)

# Every kubectl call below pins the Kind context (ADR-009: agents mutate only
# Kind). Tilt only guards its own k8s resources, not local_resource commands,
# and the current kubectl context may well be production.
KUBECTL = "kubectl --context kind-homelab-localdev"

print("=" * 60)
print("Homelab Local Development")
print("Mode: %s" % mode)
print("=" * 60)

# helm_resource apply commands are bounded by Tilt's k8s upsert timeout
# (default 30s). The cert-manager install (chart fetch + CRDs) measures
# 18-28s on GitHub-hosted runners and intermittently crosses 30s, failing
# `tilt ci` with "apply command timed out after 30s". 120s leaves headroom
# without masking a genuinely hung apply (tilt ci still caps at --timeout).
update_settings(k8s_upsert_timeout_secs=120)

# ============================================================================
# ArgoCD Mode - the Taskfile loop, driven by Tilt
# ============================================================================

if mode == "argocd":
    print("Deploying in ArgoCD mode - every Application synced from the working tree")

    # helm upgrade --install argo-cd (version from configuration/versions.yaml,
    # health Lua from charts/bootstrap/files/health) + root Application + CLI
    # login. Idempotent, so re-triggering is safe.
    local_resource(
        "argocd-install",
        cmd="task localdev:argocd",
        dir="..",
        labels=["argocd"],
    )

    # Sync every Application from the working tree, wave by wave. Re-runs on
    # any change under charts/ or configuration/ (the generated
    # values-homelab.generated.yaml files are runtime CMP output, not input).
    local_resource(
        "argocd-sync",
        cmd="task localdev:sync",
        dir="..",
        resource_deps=["argocd-install"],
        deps=["../charts", "../configuration"],
        ignore=[
            "../charts/**/values-homelab.generated.yaml",
            "../charts/**/charts/",
            "../charts/**/Chart.lock",
        ],
        trigger_mode=TRIGGER_MODE_AUTO,
        labels=["argocd"],
    )

    # Block until every Application is Healthy with a Succeeded operation;
    # dumps conditions, events and pod logs on failure. Manual: run it when
    # you want a verdict, not after every sync.
    local_resource(
        "argocd-wait",
        cmd="task localdev:wait",
        dir="..",
        resource_deps=["argocd-sync"],
        auto_init=False,
        trigger_mode=TRIGGER_MODE_MANUAL,
        labels=["argocd"],
    )

    # Same diagnostics without waiting.
    local_resource(
        "argocd-diagnose",
        cmd="task localdev:diagnose",
        dir="..",
        resource_deps=["argocd-install"],
        auto_init=False,
        trigger_mode=TRIGGER_MODE_MANUAL,
        labels=["argocd"],
    )

# ============================================================================
# Direct Mode - Direct Helm Deployment
# ============================================================================

if mode == "direct":
    print("Deploying in direct mode - fast iteration for development")

    # ========================================================================
    # Prerequisites - Storage
    # ========================================================================

    # local-path-provisioner for persistent storage. Direct mode only: in
    # ArgoCD mode the local-path-provisioner addon installs it.
    local_resource(
        "local-path-provisioner",
        cmd=KUBECTL + " apply -f https://raw.githubusercontent.com/rancher/local-path-provisioner/v0.0.26/deploy/local-path-storage.yaml",
        deps=[],
        labels=["infrastructure"],
    )

    # Set local-path as the default storage class
    local_resource(
        "default-storage-class",
        cmd=KUBECTL + """ patch storageclass local-path -p '{"metadata": {"annotations":{"storageclass.kubernetes.io/is-default-class":"true"}}}'""",
        resource_deps=["local-path-provisioner"],
        labels=["infrastructure"],
    )

    # ========================================================================
    # Core Addons
    # ========================================================================

    # Traefik Ingress Controller (NodePort mode for Kind)
    helm_resource(
        "traefik",
        chart="traefik",
        namespace="traefik",
        flags=[
            "--create-namespace",
            "--repo=https://traefik.github.io/charts",
            "--set=service.type=NodePort",
            "--set=ports.web.nodePort=30080",
            "--set=ports.websecure.nodePort=30443",
            "--set=additionalArguments={--global.checknewversion=false,--global.sendanonymoususage=false}",
            "--set=resources.requests.cpu=50m",
            "--set=resources.requests.memory=128Mi",
        ],
        resource_deps=["local-path-provisioner"],
        labels=["addons"],
    )

    # cert-manager for TLS certificate management
    helm_resource(
        "cert-manager",
        chart="cert-manager",
        namespace="cert-manager",
        flags=[
            "--create-namespace",
            "--repo=https://charts.jetstack.io",
            "--set=installCRDs=true",
            "--set=resources.requests.cpu=10m",
            "--set=resources.requests.memory=32Mi",
        ],
        resource_deps=["local-path-provisioner"],
        labels=["addons"],
    )

    # kube-prometheus-stack for monitoring (optional - resource heavy)
    # Disabled by default, enable with: tilt enable kube-prometheus-stack
    helm_resource(
        "kube-prometheus-stack",
        chart="kube-prometheus-stack",
        namespace="monitoring",
        flags=[
            "--create-namespace",
            "--repo=https://prometheus-community.github.io/helm-charts",
            "--set=prometheus.prometheusSpec.retention=1d",
            "--set=prometheus.prometheusSpec.resources.requests.memory=256Mi",
            "--set=prometheus.prometheusSpec.resources.requests.cpu=100m",
            "--set=prometheus.prometheusSpec.storageSpec.volumeClaimTemplate.spec.storageClassName=local-path",
            "--set=prometheus.prometheusSpec.storageSpec.volumeClaimTemplate.spec.resources.requests.storage=5Gi",
            "--set=grafana.adminPassword=admin",
            "--set=grafana.resources.requests.cpu=50m",
            "--set=grafana.resources.requests.memory=128Mi",
            "--set=alertmanager.enabled=false",
            "--set=nodeExporter.enabled=false",  # Not needed in Kind
            "--set=kubeStateMetrics.resources.requests.cpu=10m",
            "--set=kubeStateMetrics.resources.requests.memory=32Mi",
        ],
        resource_deps=["local-path-provisioner"],
        labels=["addons"],
        auto_init=False,  # Don't start by default - enable manually if needed
    )

    # Port forward Grafana for easy access
    # Note: Commented out because k8s_resource fails when auto_init=False
    # Uncomment this after enabling kube-prometheus-stack above
    # k8s_resource(
    #     workload="kube-prometheus-stack-grafana",
    #     new_name="grafana",
    #     port_forwards=["3000:80"],
    #     labels=["addons"],
    #     auto_init=False,
    # )

    # ========================================================================
    # Example Applications (can be extended)
    # ========================================================================

    # These would be actual application deployments
    # For now, we show the pattern - actual charts need to be created first

    # Uncomment when charts/applications exists:
    # helm_resource(
    #     "sonarr",
    #     chart="../charts/applications",
    #     namespace="media",
    #     flags=[
    #         "--create-namespace",
    #         "--values=../charts/applications/values.yaml",
    #         "--values=../charts/applications/values-localdev.yaml",
    #         "--set=sonarr.enabled=true",
    #     ],
    #     deps=["../charts/applications"],
    #     labels=["applications"],
    # )

    # Watch chart directories for hot reload
    watch_file("../charts/addons")
    watch_file("../charts/applications")
    watch_file("values/")

# ============================================================================
# Development Helpers
# ============================================================================

# Display helpful information for developers
local_resource(
    "dev-info",
    cmd="""
    echo ""
    echo "======================================"
    echo "Homelab Local Development Environment"
    echo "======================================"
    echo ""
    echo "Mode: """ + mode + """"
    echo ""
    echo "Available URLs:"
    if [ \"""" + mode + """\" = "argocd" ]; then
        echo "  ArgoCD UI:  http://localhost:8080"
        echo "              Username: admin"
        echo "              Password: kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d"
    fi
    echo "  Traefik:    http://localhost:9080"
    echo "  Grafana:    http://localhost:3000 (if enabled)"
    echo "              Username: admin"
    echo "              Password: admin"
    echo ""
    echo "Quick Commands:"
    echo "  kubectl --context kind-homelab-localdev get pods -A   # View all pods"
    echo "  tilt trigger argocd-sync             # Re-sync the working tree (argocd mode)"
    echo "  tilt trigger argocd-wait             # Wait for every Application to be Healthy (argocd mode)"
    echo "  tilt trigger argocd-diagnose         # Conditions, events, failing pod logs (argocd mode)"
    echo "  tilt enable kube-prometheus-stack    # Enable monitoring (direct mode)"
    echo ""
    echo "======================================"
    """,
    labels=["info"],
    auto_init=True,
    trigger_mode=TRIGGER_MODE_MANUAL,
)

# Cluster status check
local_resource(
    "cluster-status",
    cmd=KUBECTL + " cluster-info",
    labels=["info"],
    auto_init=True,
    trigger_mode=TRIGGER_MODE_MANUAL,
)

# Quick cleanup helper
local_resource(
    "cleanup-failed-pods",
    cmd=KUBECTL + " get pods --all-namespaces --field-selector=status.phase=Failed -o json | " +
        KUBECTL + ' delete -f - 2>/dev/null || echo "No failed pods to clean"',
    labels=["utils"],
    auto_init=False,
    trigger_mode=TRIGGER_MODE_MANUAL,
)
