# TrueNAS Secrets Configuration (Example)
# Copy this file to truenas-secrets.yml and fill in your values
# DO NOT commit the actual secrets file to git!
#
# Alternatively, use environment variables:
#   export TRUENAS_API_KEY="your-api-key-here"

# TrueNAS API Key
# Generate this from TrueNAS UI:
# 1. Log into TrueNAS Web UI
# 2. Navigate to Settings -> API Keys
# 3. Click "Add" and create a new key
# 4. Copy the generated key here
truenas_api_key: "your-truenas-api-key-here"

# Optional: If using 1Password CLI for secrets
# Uncomment and configure as needed:
# truenas_api_key: "{{ lookup('community.general.onepassword', 'TrueNAS API Key', field='credential') }}"
