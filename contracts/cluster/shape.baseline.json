        "health.memberSetSource": {
          "kind": "object"
        },
        "health.memberSetSource.observed": {
          "kind": "string",
          "value": "\"etcd-membership\""
        },
        "health.memberSetSource.api": {
          "kind": "string",
          "value": "\"EtcdStatus/MemberList\""
        },
        "health.memberSetSource.minimumReachableEndpoints": {
          "kind": "number",
          "value": "1",
          "bound": "min"
        },
        "health.memberSetSource.onNoReachableEndpoint": {
          "kind": "string",
          "value": "\"indeterminate\""
        },
        "health.memberSetSource.derivedCountRole": {
          "kind": "string",
          "value": "\"expectation-compared-against-observed\""
