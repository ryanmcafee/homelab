        "health.conditions": {
          "kind": "list"
        },
        "health.conditions.member-count": {
          "kind": "object"
        },
        "health.conditions.member-count.id": {
          "kind": "string",
          "value": "\"member-count\""
        },
        "health.conditions.member-count.rule": {
          "kind": "string",
          "value": "\"The number of members in etcd's own membership (health.memberSetSource) equals the count derived from the control-plane address keys (controlPlane.countKeyPattern), and every one of those members answered. The derived count is the expectation; etcd's membership is the observation. A consumer that counts only the endpoints it chose to dial has not evaluated this condition, it has restated its own input.\""
        },
        "health.conditions.quorum-present": {
          "kind": "object"
        },
        "health.conditions.quorum-present.id": {
          "kind": "string",
          "value": "\"quorum-present\""
        },
        "health.conditions.quorum-present.rule": {
          "kind": "string",
          "value": "\"The number of members that answered is at least quorum(count), and the number of members in etcd's membership that did not answer is at most maxUnavailable(count), both taken from the quorum table for the derived count. This is the condition that consumes the quorum rule; without it the table is data no predicate reads.\""
        },
        "health.conditions.absences-are-declared": {
          "kind": "object"
        },
        "health.conditions.absences-are-declared.id": {
          "kind": "string",
          "value": "\"absences-are-declared\""
        },
        "health.conditions.absences-are-declared.rule": {
          "kind": "string",
          "value": "\"Every expected member that did not answer is a declared target of the operation in progress. An unexplained absence is a second failure the operator did not ask for, and is never tolerated by any predicate — one target absent is a procedure in flight, one target plus one stranger is a degraded cluster.\""
        },
        "health.conditions.no-errors": {
          "kind": "object"
        },
        "health.conditions.no-errors.id": {
          "kind": "string",
          "value": "\"no-errors\""
        },
        "health.conditions.no-errors.rule": {
          "kind": "string",
          "value": "\"No member reports a non-empty ERRORS field.\""
        },
        "health.conditions.no-learners": {
          "kind": "object"
        },
        "health.conditions.no-learners.id": {
          "kind": "string",
          "value": "\"no-learners\""
        },
        "health.conditions.no-learners.rule": {
          "kind": "string",
          "value": "\"No member is a learner. A learner does not vote and does not count toward quorum.\""
        },
        "health.conditions.single-leader": {
          "kind": "object"
        },
        "health.conditions.single-leader.id": {
          "kind": "string",
          "value": "\"single-leader\""
        },
        "health.conditions.single-leader.rule": {
          "kind": "string",
          "value": "\"Exactly one member reports itself leader.\""
        },
        "health.conditions.raft-index-converged": {
          "kind": "object"
        },
        "health.conditions.raft-index-converged.id": {
          "kind": "string",
          "value": "\"raft-index-converged\""
        },
        "health.conditions.raft-index-converged.rule": {
          "kind": "string",
          "value": "\"Every member's RAFT INDEX is within `raftIndexTolerance` of the highest observed index. Members are queried at slightly different moments on a cluster that keeps writing, so exact equality is not a usable gate; a member many indices behind is still catching up and must not be counted as caught up.\""
        },
        "health.raftIndexTolerance": {
          "kind": "number",
          "value": "10"
        },
        "health.predicates": {
          "kind": "list"
        },
        "health.predicates.whole": {
          "kind": "object"
        },
        "health.predicates.whole.id": {
          "kind": "string",
          "value": "\"whole\""
        },
        "health.predicates.whole.summary": {
          "kind": "string",
          "value": "\"Every expected member is present and converged.\""
        },
        "health.predicates.whole.evaluatedOver": {
          "kind": "string",
          "value": "\"expected-members\""
        },
        "health.predicates.whole.conditions": {
          "kind": "list",
          "members": [
            "\"member-count\"",
            "\"no-errors\"",
            "\"no-learners\"",
            "\"raft-index-converged\"",
            "\"single-leader\""
          ]
        },
        "health.predicates.whole.rule": {
          "kind": "string",
          "value": "\"The gate for entering and for leaving a destructive procedure. Nothing is destroyed unless the cluster was whole beforehand, and the procedure is not reported successful until it is whole again.\""
        },
        "health.predicates.survivable": {
          "kind": "object"
        },
        "health.predicates.survivable.id": {
          "kind": "string",
          "value": "\"survivable\""
        },
        "health.predicates.survivable.summary": {
          "kind": "string",
          "value": "\"Quorum holds, every member that answered is converged, and the only members absent are the ones this operation declared it would take away.\""
        },
        "health.predicates.survivable.evaluatedOver": {
          "kind": "string",
          "value": "\"answering-members\""
        },
        "health.predicates.survivable.conditions": {
          "kind": "list",
          "members": [
            "\"absences-are-declared\"",
            "\"no-errors\"",
            "\"no-learners\"",
            "\"quorum-present\"",
            "\"raft-index-converged\"",
            "\"single-leader\""
          ]
        },
        "health.predicates.survivable.rule": {
          "kind": "string",
          "value": "\"The gate at the revalidation point and on resume, where the target is already gone or about to be. It is strictly weaker than `whole` in exactly one way — it tolerates the declared target's absence — and no weaker in any other: an absent member that is not a declared target, or more absences than maxUnavailable, is unsafe, and every member that did answer must satisfy every other condition.\""
        },
        "health.predicates.survivable.resumeSemantics": {
          "kind": "string",
          "value": "\"This is what makes the idempotent re-run decidable. After a crash between \\\"member removed\\\" and \\\"node rejoined\\\", the target is absent and declared, so `survivable` holds and the run resumes at the next step. If some other member is also absent, `survivable` fails and the run refuses — which is correct, because that cluster has a failure the operator has not seen yet. A guard an operator must bypass to finish a legitimate recovery is not a guard.\""
        },
