      "dataschema": "data/platform.bootstrap.progressed.v1.schema.json",
      "dataless": false,
      "requires": [
        "correlationid"
      ],
      "completion": null,
      "producer": "homelab-cli",
      "status": "stable",
      "payload": {
        "properties": {
          "stage": "string",
          "stageIndex": "integer",
          "stageCount": "integer",
          "outcome": "string",
          "durationSeconds": "number",
          "message": "string"
        },
        "required": [
