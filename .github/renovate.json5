{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'America/New_York',
  schedule: [
    'after 10pm every weekday',
    'before 5am every weekday',
    'every weekend',
  ],
  labels: [
    'renovate',
    'dependencies',
  ],
  assignees: [
    'ryanmcafee',
  ],
  semanticCommits: 'enabled',
  separateMajorMinor: true,
  separateMinorPatch: false,
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  rebaseWhen: 'behind-base-branch',
  automerge: false,
  platformAutomerge: false,
  packageRules: [
    {
      matchUpdateTypes: [
        'patch',
      ],
      matchCurrentVersion: '!/^0/',
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      groupName: 'Kubernetes ecosystem',
      matchDatasources: [
        'docker',
        'helm',
      ],
      matchPackageNames: [
        '/^k8s\\.io/',
        '/^kubernetes-/',
      ],
    },
    {
      groupName: 'Helm charts',
      matchDatasources: [
        'helm',
      ],
      schedule: [
        'every weekend',
      ],
    },
    {
      groupName: 'ArgoCD',
      matchPackageNames: [
        'argoproj/argo-cd',
        'argo-cd',
      ],
      matchDatasources: [
        'docker',
        'helm',
      ],
    },
    {
      groupName: 'Monitoring stack',
      matchPackageNames: [
        'kube-prometheus-stack',
        'prometheus-operator',
        'grafana',
        'alertmanager',
      ],
    },
    {
      groupName: 'Terraform providers',
      matchDatasources: [
        'terraform-provider',
      ],
      schedule: [
        'every weekend',
      ],
    },
    {
      groupName: 'Ansible collections',
      matchDatasources: [
        'ansible-galaxy',
      ],
      schedule: [
        'every weekend',
      ],
    },
    {
      groupName: 'Container images',
      matchDatasources: [
        'docker',
      ],
      schedule: [
        'after 10pm every weekday',
      ],
    },
    {
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      pinDigests: true,
    },
    {
      groupName: 'TrueCharts applications',
      matchPackageNames: [
        'oci.trueforge.org/truecharts/sonarr',
        'oci.trueforge.org/truecharts/radarr',
        'oci.trueforge.org/truecharts/prowlarr',
        'oci.trueforge.org/truecharts/nzbget',
        'oci.trueforge.org/truecharts/tautulli',
        'oci.trueforge.org/truecharts/lazylibrarian',
        'oci.trueforge.org/truecharts/home-assistant',
        'oci.trueforge.org/truecharts/mosquitto',
        'oci.trueforge.org/truecharts/flaresolverr',
      ],
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        'configuration/versions.yaml',
      ],
      schedule: [
        'every weekend',
      ],
    },
    {
      groupName: 'Infrastructure tools',
      matchPackageNames: [
        'siderolabs/talos',
        'kubernetes/kubernetes',
        'hashicorp/terraform',
        'helm/helm',
      ],
      matchDatasources: [
        'github-releases',
      ],
      schedule: [
        'every weekend',
      ],
      automerge: false,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      matchFileNames: [
        'configuration/versions.yaml',
      ],
      automerge: false,
      labels: [
        'renovate',
        'dependencies',
        'major',
      ],
    },
  ],
  'helm-values': {
    managerFilePatterns: [
      '/charts/.+/values\\.yaml$/',
      '/charts/.+/values-.+\\.yaml$/',
    ],
  },
  terraform: {
    enabled: true,
    managerFilePatterns: [
      '/\\.tf$/',
      '/\\.hcl$/',
    ],
  },
  ansible: {
    enabled: true,
    managerFilePatterns: [
      '/requirements\\.yml$/',
      '/galaxy\\.yml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/configuration/versions\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( registryUrl=(?<registryUrl>.*?))?\\s+[\\w-]+:\\s*"(?<currentValue>[^"]+)"',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/talos/image/schematic\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+version: (?<currentValue>.*)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'siderolabs/talos',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+.+_VERSION: [\'"]?(?<currentValue>[^\'"\\s]+)',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/Taskfile\\.yml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+version: [\'"]?(?<currentValue>[^\'"\\s]+)',
      ],
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
      'vulnerability',
    ],
    assignees: [
      'ryanmcafee',
    ],
    automerge: false,
  },
  prBodyTemplate: '{{{header}}}{{{table}}}{{{notes}}}{{{changelogs}}}{{{configDescription}}}{{{controls}}}{{{footer}}}',
  commitMessagePrefix: '{{#if semanticCommitType}}{{semanticCommitType}}{{#if semanticCommitScope}}({{semanticCommitScope}}){{/if}}: {{/if}}',
  commitMessageAction: 'Update',
  commitMessageTopic: '{{{depName}}}',
  commitMessageExtra: 'to {{{newVersion}}}',
  ignoreDeps: [],
}
