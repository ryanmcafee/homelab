{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'America/New_York',
  schedule: [
    'after 10pm every weekday',
    'before 5am every weekday',
    'every weekend',
  ],
  labels: [
    'renovate',
    'dependencies',
  ],
  assignees: [
    'ryanmcafee',
  ],
  semanticCommits: 'enabled',
  separateMajorMinor: true,
  separateMinorPatch: false,
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  rebaseWhen: 'behind-base-branch',
  automerge: false,
  // Renovate merges an automerge PR itself, and only once every status check
  // on the head commit is green. platformAutomerge (GitHub native auto-merge)
  // is never used: the main ruleset requires no status checks, so GitHub
  // would merge the moment the PR opened, before CI or the upgrade gate ran.
  platformAutomerge: false,
  // .github/workflows/upgrade.yml (job regenerate) commits regenerated
  // snapshots, schemas and localdev values onto renovate/* branches as this
  // author. Ignoring it keeps Renovate managing (and rebasing) the branch
  // instead of treating it as edited by a human.
  gitIgnoredAuthors: [
    'homelab-regen-bot@users.noreply.github.com',
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'patch',
      ],
      matchCurrentVersion: '!/^v?0\\./',
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
    },
    {
      groupName: 'Kubernetes ecosystem',
      matchDatasources: [
        'docker',
        'helm',
      ],
      matchPackageNames: [
        '/^k8s\\.io/',
        '/^kubernetes-/',
      ],
    },
    {
      groupName: 'Helm charts',
      matchDatasources: [
        'helm',
      ],
      schedule: [
        'every weekend',
      ],
    },
    {
      groupName: 'ArgoCD',
      matchPackageNames: [
        'argoproj/argo-cd',
        'argo-cd',
      ],
      matchDatasources: [
        'docker',
        'helm',
      ],
    },
    {
      groupName: 'Monitoring stack',
      matchPackageNames: [
        'kube-prometheus-stack',
        'prometheus-operator',
        'grafana',
        'alertmanager',
      ],
    },
    {
      groupName: 'Terraform providers',
      matchDatasources: [
        'terraform-provider',
      ],
      schedule: [
        'every weekend',
      ],
    },
    {
      groupName: 'Ansible collections',
      matchDatasources: [
        'ansible-galaxy',
      ],
      schedule: [
        'every weekend',
      ],
    },
    {
      groupName: 'Container images',
      matchDatasources: [
        'docker',
      ],
      schedule: [
        'after 10pm every weekday',
      ],
    },
    {
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      pinDigests: true,
    },
    {
      groupName: 'TrueCharts applications',
      matchPackageNames: [
        'oci.trueforge.org/truecharts/sonarr',
        'oci.trueforge.org/truecharts/radarr',
        'oci.trueforge.org/truecharts/prowlarr',
        'oci.trueforge.org/truecharts/nzbget',
        'oci.trueforge.org/truecharts/tautulli',
        'oci.trueforge.org/truecharts/lazylibrarian',
        'oci.trueforge.org/truecharts/home-assistant',
        'oci.trueforge.org/truecharts/mosquitto',
        'oci.trueforge.org/truecharts/flaresolverr',
      ],
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        'configuration/versions.yaml',
      ],
      schedule: [
        'every weekend',
      ],
    },
    // Non-major chart and image bumps in versions.yaml automerge only through
    // the upgrade gate: upgrade.yml sets the upgrade/automerge-gate commit
    // status to failure whenever a rendered manifest changes or a custom
    // resource no longer validates, and Renovate merges only when every status
    // is green. 0.x versions, majors (rule below), infrastructure tools,
    // kindest/node (tracks the Kubernetes version) and ksops stay manual.
    {
      matchFileNames: [
        'configuration/versions.yaml',
      ],
      matchDatasources: [
        'helm',
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchCurrentVersion: '!/^v?0\\./',
      matchPackageNames: [
        '!kindest/node',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      prBodyNotes: [
        '**Upgrade gate:** `upgrade.yml` renders every upstream chart this PR changes at `main` and at this branch, posts the manifest diff as the `upgrade-diff` comment, re-vendors the CRD schemas and revalidates every custom resource. Renovate automerges only when the `upgrade/automerge-gate` status is green, which requires an empty rendered diff; any manifest change needs a human review. When the regeneration bot is configured it commits the snapshots, schemas and localdev values (see docs/runbooks/verification.md, "Renovate bumps").',
      ],
    },
    {
      groupName: 'Infrastructure tools',
      matchPackageNames: [
        'siderolabs/talos',
        'kubernetes/kubernetes',
        'hashicorp/terraform',
        'helm/helm',
      ],
      matchDatasources: [
        'github-releases',
      ],
      schedule: [
        'every weekend',
      ],
      automerge: false,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      matchFileNames: [
        'configuration/versions.yaml',
      ],
      automerge: false,
      labels: [
        'renovate',
        'dependencies',
        'major',
      ],
    },
    // ksops: distroless images may break init containers — disable auto-merge
    {
      matchPackageNames: [
        'viaductoss/ksops',
      ],
      matchDatasources: [
        'docker',
      ],
      automerge: false,
      labels: [
        'renovate',
        'dependencies',
        'requires-testing',
      ],
    },
  ],
  // Patterns are anchored at the repository root: internal/scaffold/testdata/repo
  // holds a miniature copy of charts/, configuration/ and Taskfile.yml whose golden
  // tests must never be bumped.
  'helm-values': {
    managerFilePatterns: [
      '/^charts/.+/values\\.yaml$/',
      '/^charts/.+/values-.+\\.yaml$/',
    ],
  },
  terraform: {
    enabled: true,
    managerFilePatterns: [
      '/\\.tf$/',
      '/\\.hcl$/',
    ],
  },
  ansible: {
    enabled: true,
    managerFilePatterns: [
      '/requirements\\.yml$/',
      '/galaxy\\.yml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^configuration/versions\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( registryUrl=(?<registryUrl>.*?))?\\s+[\\w-]+:\\s*"(?<currentValue>[^"]+)"',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/talos/image/schematic\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+version: (?<currentValue>.*)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'siderolabs/talos',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.yml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+.+_VERSION: [\'"]?(?<currentValue>[^\'"\\s]+)',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Taskfile\\.yml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+version: [\'"]?(?<currentValue>[^\'"\\s]+)',
      ],
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
      'vulnerability',
    ],
    assignees: [
      'ryanmcafee',
    ],
    automerge: false,
  },
  prBodyTemplate: '{{{header}}}{{{table}}}{{{notes}}}{{{changelogs}}}{{{configDescription}}}{{{controls}}}{{{footer}}}',
  commitMessagePrefix: '{{#if semanticCommitType}}{{semanticCommitType}}{{#if semanticCommitScope}}({{semanticCommitScope}}){{/if}}: {{/if}}',
  commitMessageAction: 'Update',
  commitMessageTopic: '{{{depName}}}',
  commitMessageExtra: 'to {{{newVersion}}}',
  ignoreDeps: [],
}
