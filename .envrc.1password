# Homelab Environment Variables - Using 1Password
# This version references secrets from 1Password instead of hardcoding them
# Use direnv to automatically load these variables: https://direnv.net/

# ============================================================================
# 1Password Configuration
# ============================================================================
# 1Password Connect Server (for CI/CD and automation)
export TF_VAR_onepassword_credentials_json="$(cat ~/.op/1password-credentials.json)"
export OP_CONNECT_HOST="$(op read 'op://homelab/onepassword-connect/connect_host')"
export OP_CONNECT_TOKEN="$(op read 'op://homelab/onepassword-connect/connect_token')"

# 1Password CLI (for local development)
export OP_SERVICE_ACCOUNT_TOKEN="$(op read 'op://homelab/onepassword-connect/service_account_token')"

# ============================================================================
# Proxmox Configuration
# ============================================================================
export TF_VAR_proxmox_api_url="$(op read 'op://homelab/proxmox/api_url')"
export TF_VAR_proxmox_api_token_id="$(op read 'op://homelab/proxmox/api_token_id')"
export TF_VAR_proxmox_api_token_secret="$(op read 'op://homelab/proxmox/api_token_secret')"
export TF_VAR_proxmox_node="$(op read 'op://homelab/proxmox/node')"

# ============================================================================
# TrueNAS Configuration
# ============================================================================
export TF_VAR_truenas_api_key="$(op read 'op://homelab/truenas/api_key')"
export TF_VAR_truenas_host="$(op read 'op://homelab/truenas/host')"

# ============================================================================
# Network Configuration
# ============================================================================
export TF_VAR_base_fqdn="$(op read 'op://homelab/network-config/base_fqdn')"
export TF_VAR_cloudflare_api_token="$(op read 'op://homelab/cloudflare/api_token')"
export TF_VAR_cloudflare_zone_id="$(op read 'op://homelab/cloudflare/zone_id')"

# ============================================================================
# Kubernetes Configuration
# ============================================================================
export TF_VAR_cluster_name="$(op read 'op://homelab/network-config/cluster_name')"
export TF_VAR_environment="$(op read 'op://homelab/network-config/environment')"  # localdev, dev, or prod
export KUBECONFIG="${HOME}/.kube/homelab-${TF_VAR_environment}.yaml"

# ============================================================================
# Ansible Configuration
# ============================================================================
export ANSIBLE_CONFIG="${PWD}/ansible/ansible.cfg"
export ANSIBLE_INVENTORY="${PWD}/ansible/inventory/hosts.yml"
export ANSIBLE_ROLES_PATH="${PWD}/ansible/roles:~/.ansible/roles:/usr/share/ansible/roles:/etc/ansible/roles"
export ANSIBLE_VAULT_PASSWORD_FILE="${HOME}/.ansible_vault_password"

# ============================================================================
# Local Development
# ============================================================================
# Tilt mode: "direct" or "argocd"
export TILT_MODE="direct"

# Enable debug logging
# export TF_LOG=DEBUG
# export ANSIBLE_DEBUG=1

# ============================================================================
# Optional: GitHub Actions (for local testing with act)
# ============================================================================
# export GITHUB_TOKEN="<your-github-pat>"
