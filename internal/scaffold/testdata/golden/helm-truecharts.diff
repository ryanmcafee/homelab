+++ b/charts/applications/templates/demo-web.yaml
@@ -0,0 +1,91 @@
+{{- /*
+demo-web (helm pattern), scaffolded by:
+  homelab scaffold app demo-web --pattern helm --chart-repo oci://oci.trueforge.org/truecharts --chart-version 2.0.0 --port 8080 --health-path /healthz --expect 200,401
+Chart, version, values and smoke URL come from the `demo-web:` block of
+configuration/templates/helm-apps.tmpl; charts/applications/values.yaml only holds
+placeholders. See docs/apps/demo-web.md.
+*/}}
+{{- $app := index .Values "demo-web" }}
+{{- /*
+Preview mode (templates/_preview.tpl, docs/runbooks/previews.md): the app renders
+in a PR preview only once it is listed in global.preview.allowedApps; the
+helpers then rename it, move it to preview-<pr>, rewrite its hosts and give it
+fresh storage.
+*/}}
+{{- if include "homelab.preview.appEnabled" (dict "root" . "app" "demo-web") }}
+{{- $preview := include "homelab.preview.enabled" . }}
+{{- $values := $app.values }}
+{{- if and $preview $values (hasKey $values "persistence") }}
+{{- $values = omit $values "persistence" }}
+{{- $_ := set $values "persistence" (include "homelab.preview.persistence" (dict "root" . "persistence" $app.values.persistence) | fromYaml) }}
+{{- end }}
+{{- $smoke := include "homelab.preview.smoke" (dict "root" . "smoke" $app.smoke "namespace" $app.namespace) | fromYaml }}
+{{- /*
+One Application with the upstream chart and a PostSync smoke hook; there is no
+demo-web-config child. Add charts/demo-web-config (and a demo-web-config
+Application in a different wave) only when the app needs objects the upstream
+chart cannot render, e.g. a static PV for existing data (see sonarr).
+*/}}
+{{- if not $preview }}
+---
+# Namespace demo-web: nothing else renders it, and the smoke Job below
+# lands in it before the Application's CreateNamespace=true would.
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: {{ $app.namespace }}
+  annotations:
+    argocd.argoproj.io/sync-wave: "-1"
+{{- end }}
+---
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: {{ include "homelab.preview.appName" (dict "root" $ "app" "demo-web") }}
+  namespace: {{ include "homelab.preview.appNamespace" $ }}
+  annotations:
+    argocd.argoproj.io/sync-wave: "13"
+  finalizers:
+    - resources-finalizer.argocd.argoproj.io
+spec:
+  project: {{ include "homelab.preview.project" $ }}
+  source:
+    repoURL: {{ $app.chart.repo }}
+    chart: {{ $app.chart.name }}
+    targetRevision: {{ $app.chart.version | quote }}
+    helm:
+      releaseName: demo-web
+      {{- with $values }}
+      values: |
+        {{- include "homelab.preview.hosts" (dict "root" $ "text" (toYaml .)) | nindent 8 }}
+      {{- end }}
+  destination:
+    server: https://kubernetes.default.svc
+    namespace: {{ include "homelab.preview.destNamespace" (dict "root" $ "namespace" $app.namespace) }}
+
+  # Ignore TrueCharts dynamic fields and Kubernetes defaults
+  ignoreDifferences:
+    - group: apps
+      kind: Deployment
+      jqPathExpressions:
+        - .spec.template.metadata.annotations | to_entries | map(select(.key | startswith("checksum/"))) | from_entries
+      jsonPointers:
+        - /spec/template/spec/hostUsers
+
+  syncPolicy:
+    {{- if $.Values.global.automatedSync }}
+    automated:
+      prune: true
+      selfHeal: true
+    {{- end }}
+    syncOptions:
+      - CreateNamespace=true
+      - ServerSideApply=true
+    retry:
+      limit: 5
+      backoff:
+        duration: 5s
+        factor: 2
+        maxDuration: 3m
+{{- include "homelab.smokeJob" (dict "name" "demo-web" "namespace" (include "homelab.preview.destNamespace" (dict "root" $ "namespace" $app.namespace)) "smoke" $smoke "wave" "13" "image" $.Values.global.images.curl) }}
+{{- end }}
