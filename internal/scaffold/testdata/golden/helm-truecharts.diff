@@ -0,0 +1,34 @@
+# demo-web
+
+Pattern: upstream Helm chart (helm), parent chart `charts/applications`. Scaffolded with:
+
+```bash
+homelab scaffold app demo-web --pattern helm --chart-repo oci://oci.trueforge.org/truecharts --chart-version 2.0.0 --port 8080 --health-path /healthz --expect 200,401
+```
+
+## Generated
+
+| Path | Purpose |
+|------|---------|
+| `.github/renovate.json5` | TrueCharts Renovate group |
+| `charts/applications/templates/demo-web.yaml` | ArgoCD Application(s): demo-web |
+| `charts/applications/values.yaml` | placeholder values block |
+| `configuration/schema/applications.schema.yaml` | `DEMO_WEB_HOSTNAME` hostname key |
+| `configuration/templates/helm-apps.tmpl` | values for every environment (version, sizing, hostname, smoke URL) |
+| `configuration/versions.yaml` | chart version with its Renovate marker |
+| `tests/e2e/demo-web/chainsaw-test.yaml` | chainsaw e2e test |
+
+## Before the first PR
+
+- [ ] Adapt the `values:` block in `configuration/templates/helm-apps.tmpl` to the chart's own values
+- [ ] Check that `smoke.url` (`http://demo-web.demo-web.svc.cluster.local:8080/healthz`) names the chart's Service and port
+- [ ] Seed any Secret 1Password provides in homelab in `localdev/fakes/secrets.yaml`
+- [ ] Replace this checklist with what the app does and how to operate it
+
+## Verify
+
+```bash
+task verify:text                                   # level 0
+task localdev:up && task verify:text LEVEL=2       # Kind: Healthy + Succeeded, e2e
+task test:e2e -- --test-dir tests/e2e/demo-web
+```
diff --git a/tests/e2e/demo-web/chainsaw-test.yaml b/tests/e2e/demo-web/chainsaw-test.yaml
new file mode 100644
--- /dev/null
+++ b/tests/e2e/demo-web/chainsaw-test.yaml
@@ -0,0 +1,138 @@
+---
+# Scaffolded by `homelab scaffold app demo-web`; see tests/e2e/README.md.
+apiVersion: chainsaw.kyverno.io/v1alpha1
+kind: Test
+metadata:
+  name: demo-web
+spec:
+  description: >-
+    The demo-web HTTPRoute is accepted by envoy-internal and demo-web /healthz
+    answers through it with Host demo-web.homelab.local.
+  steps:
+    - name: applications-healthy
+      description: The ArgoCD Applications behind this test are Healthy and their last sync Succeeded.
+      try:
+        - assert:
+            resource:
+              apiVersion: argoproj.io/v1alpha1
+              kind: Application
+              metadata:
+                name: demo-web
+                namespace: argocd
+              status:
+                health:
+                  status: Healthy
+                operationState:
+                  phase: Succeeded
+      catch:
+        - describe:
+            apiVersion: argoproj.io/v1alpha1
+            kind: Application
+            name: demo-web
+            namespace: argocd
+    - name: route-demo-web
+      description: The demo-web HTTPRoute is Accepted by envoy-internal and its backend refs resolve.
+      try:
+        - assert:
+            resource:
+              apiVersion: gateway.networking.k8s.io/v1
+              kind: HTTPRoute
+              metadata:
+                name: demo-web
+                namespace: demo-web
+              status:
+                (parents[?parentRef.name == 'envoy-internal']):
+                  - (conditions[?type == 'Accepted']):
+                      - status: "True"
+                    (conditions[?type == 'ResolvedRefs']):
+                      - status: "True"
+      catch:
+        - describe:
+            apiVersion: gateway.networking.k8s.io/v1
+            kind: HTTPRoute
+            name: demo-web
+            namespace: demo-web
+    - name: curl-demo-web
+      description: >-
+        A curl Job must get one of [200, 401]
+        from https://demo-web.homelab.local/healthz via envoy-internal.envoy-gateway-system.svc.cluster.local.
+      timeouts:
+        assert: 5m
+      try:
+        - apply:
+            resource:
+              apiVersion: batch/v1
+              kind: Job
+              metadata:
+                name: curl-demo-web
+              spec:
+                backoffLimit: 0
+                activeDeadlineSeconds: 300
+                template:
+                  spec:
+                    restartPolicy: Never
+                    securityContext:
+                      runAsNonRoot: true
+                      runAsUser: 100
+                      seccompProfile:
+                        type: RuntimeDefault
+                    containers:
+                      - name: curl
+                        # pinned from configuration/versions.yaml images.curl
+                        image: curlimages/curl:8.22.0
+                        securityContext:
+                          allowPrivilegeEscalation: false
+                          capabilities:
+                            drop: ["ALL"]
+                        resources:
+                          requests:
+                            cpu: 10m
+                            memory: 32Mi
+                          limits:
+                            cpu: 100m
+                            memory: 64Mi
+                        env:
+                          - name: HOST
+                            value: "demo-web.homelab.local"
+                          - name: GATEWAY
+                            value: "envoy-internal.envoy-gateway-system.svc.cluster.local"
+                          - name: URL_PATH
+                            value: "/healthz"
+                          - name: EXPECT
+                            value: "200 401"
+                          - name: ATTEMPTS
+                            value: "20"
+                        command: ["sh", "-c"]
+                        args:
+                          - |
+                            set -u
+                            i=1
+                            while [ "$i" -le "$ATTEMPTS" ]; do
+                              code=$(curl -sk -o /dev/null -w '%{http_code}' -L --max-redirs 5 --max-time 20 \
+                                --connect-to "$HOST:443:$GATEWAY:443" --connect-to "$HOST:80:$GATEWAY:80" \
+                                "https://$HOST$URL_PATH")
+                              echo "attempt $i/$ATTEMPTS: HTTP $code for https://$HOST$URL_PATH via $GATEWAY"
+                              for ok in $EXPECT; do [ "$code" = "$ok" ] && exit 0; done
+                              i=$((i + 1))
+                              sleep 6
+                            done
+                            echo "giving up: last HTTP code $code, expected one of: $EXPECT"
+                            exit 1
+        - assert:
+            resource:
+              apiVersion: batch/v1
+              kind: Job
+              metadata:
+                name: curl-demo-web
+              status:
+                succeeded: 1
+      catch:
+        - events: {}
+        - podLogs:
+            selector: job-name=curl-demo-web
+            tail: 50
+        - describe:
+            apiVersion: argoproj.io/v1alpha1
+            kind: Application
+            name: demo-web
+            namespace: argocd
