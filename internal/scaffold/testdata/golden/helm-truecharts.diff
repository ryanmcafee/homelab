+# ============================================================================
+# demo-web - upstream Helm chart (scaffolded)
+# homelab scaffold app demo-web --pattern helm --chart-repo oci://oci.trueforge.org/truecharts --chart-version 2.0.0 --port 8080 --health-path /healthz --expect 200,401
+# Sync Wave: 13
+# ============================================================================
+
+demo-web:
+  enabled: true
+  namespace: demo-web
+
+  # ArgoCD source: repoURL (no oci:// scheme for OCI registries), chart name and
+  # version. configuration/versions.yaml charts.demo-web is the only place to bump it.
+  chart:
+    name: demo-web
+    repo: oci.trueforge.org/truecharts
+    version: "{{ index .Versions.Charts "demo-web" }}"
+
+  # Handed verbatim to the upstream chart (spec.source.helm.values), in the
+  # TrueCharts common-library layout (compare the sonarr block).
+  values:
+    workload:
+      main:
+        podSpec:
+{{- if $localdev }}
+          # Kind nodes run the host architecture (arm64 on Apple Silicon). Drop the
+          # TrueCharts common default kubernetes.io/arch=amd64 pin; null deletes the
+          # key when helm merges values, so the pod schedules on any node.
+          nodeSelector:
+            kubernetes.io/arch: null
+{{- end }}
+          containers:
+            main:
+              resources:
+                requests:
+                  cpu: 100m
+                  memory: 128Mi
+                limits:
+                  cpu: 500m
+                  memory: 512Mi
+    persistence:
+      config:
+        enabled: true
+        storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
+        size: 1Gi
+    route:
+      main:
+        enabled: true
+        kind: HTTPRoute
+        annotations:
+          external-dns.alpha.kubernetes.io/hostname: {{ .Values.DEMO_WEB_HOSTNAME.Value }}
+        parentRefs:
+          - group: gateway.networking.k8s.io
+            kind: Gateway
+            name: {{ .Values.GATEWAY_INTERNAL.Value }}
+            namespace: {{ .Values.GATEWAY_NAMESPACE.Value }}
+            sectionName: https
+        hostnames:
+          - {{ .Values.DEMO_WEB_HOSTNAME.Value }}
+    TZ: {{ .Values.TIMEZONE.Value }}
+
+  # PostSync smoke hook (charts/applications/templates/_smoke.tpl): curl the
+  # in-cluster Service after sync; expect lists the accepted HTTP codes.
+  smoke:
+    enabled: true
+    url: http://demo-web.demo-web.svc.cluster.local:8080/healthz
+    expect: ["200", "401"]
