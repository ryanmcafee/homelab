+# demo-stack-dependencies values: prerequisites synced before demo-stack
+# (wave 9 < 10). Scaffolded by `homelab scaffold app demo-stack`.
+
+namespace: demo-stack
+
+# A 1Password item the operator materialises as Secret <secretName>. Inert until
+# both enabled and itemPath are set. Localdev has no secret store
