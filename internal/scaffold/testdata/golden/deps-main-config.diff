+    version: "2.0.0"
+
+  # Handed verbatim to the upstream chart (spec.source.helm.values).
+  values: {}
+
+  # Handed to charts/demo-stack-config through the demo-stack-config Application's
+  # helm.valuesObject (ADR-010).
+  config: {}
+
+  smoke:
+    enabled: false
