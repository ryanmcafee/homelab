--- /dev/null
+++ b/charts/addons/templates/demo-stack.yaml
@@ -0,0 +1,145 @@
+{{- /*
+demo-stack (deps-main-config pattern), scaffolded by:
+  homelab scaffold app demo-stack --pattern deps-main-config --chart-repo https://charts.example.com/demo --chart-name stack --chart-version 2.0.0 --health-path /alive
+Chart, version, values and smoke URL come from the `demo-stack:` block of
+configuration/templates/helm-addons.tmpl; charts/addons/values.yaml only holds
+placeholders. See docs/apps/demo-stack.md.
+*/}}
+{{- $app := index .Values "demo-stack" }}
+{{- if $app.enabled }}
+{{- /*
+Three Applications (rule gitops/<env>/waves: -dependencies < main, -config != main):
+  wave 9  demo-stack-dependencies  charts/demo-stack-dependencies (Secrets, OnePasswordItems)
+  wave 10  demo-stack               upstream chart stack
+  wave 12  demo-stack-config        charts/demo-stack-config (HTTPRoute; anything needing the main chart)
+Derived values reach the -config child through helm.valuesObject (ADR-010).
+*/}}
+---
+# Namespace demo-stack: nothing else renders it, and the smoke Job below
+# lands in it before the Application's CreateNamespace=true would.
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: {{ $app.namespace }}
+  annotations:
+    argocd.argoproj.io/sync-wave: "-1"
+---
+# Dependencies Application: prerequisites of demo-stack (Secrets, OnePasswordItems)
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: demo-stack-dependencies
+  namespace: argocd
+  annotations:
+    argocd.argoproj.io/sync-wave: "9"
+  finalizers:
+    - resources-finalizer.argocd.argoproj.io
+spec:
+  project: default
+  source:
+    repoURL: {{ $.Values.global.repoUrl }}
+    targetRevision: {{ $.Values.global.targetRevision }}
+    path: charts/demo-stack-dependencies
+    helm:
+      valueFiles:
+        - values.yaml
+        - values-{{ $.Values.global.environment }}.yaml
+  destination:
+    server: https://kubernetes.default.svc
+    namespace: {{ $app.namespace }}
+  syncPolicy:
+    {{- if $.Values.global.automatedSync }}
+    automated:
+      prune: true
+      selfHeal: true
+    {{- end }}
+    syncOptions:
+      - CreateNamespace=true
+      - ServerSideApply=true
+      - SkipDryRunOnMissingResource=true
+---
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: demo-stack
+  namespace: argocd
+  annotations:
+    argocd.argoproj.io/sync-wave: "10"
+  finalizers:
+    - resources-finalizer.argocd.argoproj.io
+spec:
+  project: default
+  source:
+    repoURL: {{ $app.chart.repo }}
+    chart: {{ $app.chart.name }}
+    targetRevision: {{ $app.chart.version | quote }}
+    helm:
+      releaseName: demo-stack
+      {{- with $app.values }}
+      values: |
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+  destination:
+    server: https://kubernetes.default.svc
+    namespace: {{ $app.namespace }}
+
+  syncPolicy:
+    {{- if $.Values.global.automatedSync }}
+    automated:
+      prune: true
+      selfHeal: true
+    {{- end }}
+    syncOptions:
+      - CreateNamespace=true
+      - ServerSideApply=true
+    retry:
+      limit: 5
+      backoff:
+        duration: 5s
+        factor: 2
+        maxDuration: 3m
+{{- include "homelab.smokeJob" (dict "name" "demo-stack" "namespace" $app.namespace "smoke" $app.smoke "wave" "10" "image" $.Values.global.images.curl) }}
+---
+# Config Application: objects that need the main chart (its Service, its CRDs)
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: demo-stack-config
+  namespace: argocd
+  annotations:
+    argocd.argoproj.io/sync-wave: "12"
+  finalizers:
+    - resources-finalizer.argocd.argoproj.io
+spec:
+  project: default
+  source:
+    repoURL: {{ $.Values.global.repoUrl }}
+    targetRevision: {{ $.Values.global.targetRevision }}
+    path: charts/demo-stack-config
+    helm:
+      valueFiles:
+        - values.yaml
+        - values-{{ $.Values.global.environment }}.yaml
+      # Derived values (domain, hostname) come from this parent's values
+      # (configuration/ via the CMP in homelab) so the child's committed values
+      # files stay PII-free. valuesObject overrides valueFiles in ArgoCD.
+      valuesObject:
+        global:
+          domain: {{ $.Values.global.domain }}
+        {{- with $app.config }}
+        {{- toYaml . | nindent 8 }}
+        {{- end }}
+  destination:
+    server: https://kubernetes.default.svc
+    namespace: {{ $app.namespace }}
+  syncPolicy:
+    {{- if $.Values.global.automatedSync }}
+    automated:
+      prune: true
+      selfHeal: true
+    {{- end }}
+    syncOptions:
+      - CreateNamespace=true
+      - ServerSideApply=true
+      - SkipDryRunOnMissingResource=true
+{{- end }}
