+# demo-suite-dependencies values: prerequisites synced before demo-suite
+# (wave 12 < 13). Scaffolded by `homelab scaffold app demo-suite`.
+
+namespace: demo-suite
+
+# A 1Password item the operator materialises as Secret <secretName>. Inert until
+# both enabled and itemPath are set. Localdev has no secret store
