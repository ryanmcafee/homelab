new file mode 100644
--- /dev/null
+++ b/charts/applications/templates/demo-suite.yaml
@@ -0,0 +1,164 @@
+{{- /*
+demo-suite (deps-main-config pattern), scaffolded by:
+  homelab scaffold app demo-suite --pattern deps-main-config --tier applications --chart-repo https://charts.example.com/demo --chart-version 3.1.4 --port 3000
+Chart, version, values and smoke URL come from the `demo-suite:` block of
+configuration/templates/helm-apps.tmpl; charts/applications/values.yaml only holds
+placeholders. See docs/apps/demo-suite.md.
+*/}}
+{{- $app := index .Values "demo-suite" }}
+{{- /*
+Preview mode (templates/_preview.tpl, docs/runbooks/previews.md): the app renders
+in a PR preview only once it is listed in global.preview.allowedApps; the
+helpers then rename it, move it to preview-<pr>, rewrite its hosts and give it
+fresh storage.
+*/}}
+{{- if include "homelab.preview.appEnabled" (dict "root" . "app" "demo-suite") }}
+{{- $preview := include "homelab.preview.enabled" . }}
+{{- $values := $app.values }}
+{{- if and $preview $values (hasKey $values "persistence") }}
+{{- $values = omit $values "persistence" }}
+{{- $_ := set $values "persistence" (include "homelab.preview.persistence" (dict "root" . "persistence" $app.values.persistence) | fromYaml) }}
+{{- end }}
+{{- $smoke := include "homelab.preview.smoke" (dict "root" . "smoke" $app.smoke "namespace" $app.namespace) | fromYaml }}
+{{- /*
+Three Applications (rule gitops/<env>/waves: -dependencies < main, -config != main):
+  wave 12  demo-suite-dependencies  charts/demo-suite-dependencies (Secrets, OnePasswordItems)
+  wave 13  demo-suite               upstream chart demo-suite
+  wave 15  demo-suite-config        charts/demo-suite-config (HTTPRoute; anything needing the main chart)
+Derived values reach the -config child through helm.valuesObject (ADR-010).
+*/}}
+{{- if not $preview }}
+---
+# Namespace demo-suite: nothing else renders it, and the smoke Job below
+# lands in it before the Application's CreateNamespace=true would.
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: {{ $app.namespace }}
+  annotations:
+    argocd.argoproj.io/sync-wave: "-1"
+{{- end }}
+{{- if not $preview }}
+---
+# Dependencies Application: prerequisites of demo-suite (Secrets, OnePasswordItems)
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: demo-suite-dependencies
+  namespace: argocd
+  annotations:
+    argocd.argoproj.io/sync-wave: "12"
+  finalizers:
+    - resources-finalizer.argocd.argoproj.io
+spec:
+  project: default
+  source:
+    repoURL: {{ $.Values.global.repoUrl }}
+    targetRevision: {{ $.Values.global.targetRevision }}
+    path: charts/demo-suite-dependencies
+    helm:
+      valueFiles:
+        - values.yaml
+        - values-{{ $.Values.global.environment }}.yaml
+  destination:
+    server: https://kubernetes.default.svc
+    namespace: {{ $app.namespace }}
+  syncPolicy:
+    {{- if $.Values.global.automatedSync }}
+    automated:
+      prune: true
+      selfHeal: true
+    {{- end }}
+    syncOptions:
+      - CreateNamespace=true
+      - ServerSideApply=true
+      - SkipDryRunOnMissingResource=true
+{{- end }}
+---
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: {{ include "homelab.preview.appName" (dict "root" $ "app" "demo-suite") }}
+  namespace: {{ include "homelab.preview.appNamespace" $ }}
+  annotations:
+    argocd.argoproj.io/sync-wave: "13"
+  finalizers:
+    - resources-finalizer.argocd.argoproj.io
+spec:
+  project: {{ include "homelab.preview.project" $ }}
+  source:
+    repoURL: {{ $app.chart.repo }}
+    chart: {{ $app.chart.name }}
+    targetRevision: {{ $app.chart.version | quote }}
+    helm:
+      releaseName: demo-suite
+      {{- with $values }}
+      values: |
+        {{- include "homelab.preview.hosts" (dict "root" $ "text" (toYaml .)) | nindent 8 }}
+      {{- end }}
+  destination:
+    server: https://kubernetes.default.svc
+    namespace: {{ include "homelab.preview.destNamespace" (dict "root" $ "namespace" $app.namespace) }}
+
+  syncPolicy:
+    {{- if $.Values.global.automatedSync }}
+    automated:
+      prune: true
+      selfHeal: true
+    {{- end }}
+    syncOptions:
+      - CreateNamespace=true
+      - ServerSideApply=true
+    retry:
+      limit: 5
+      backoff:
+        duration: 5s
+        factor: 2
+        maxDuration: 3m
+{{- include "homelab.smokeJob" (dict "name" "demo-suite" "namespace" (include "homelab.preview.destNamespace" (dict "root" $ "namespace" $app.namespace)) "smoke" $smoke "wave" "13" "image" $.Values.global.images.curl) }}
+{{- if not $preview }}
+---
+# Config Application: objects that need the main chart (its Service, its CRDs)
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: demo-suite-config
+  namespace: argocd
+  annotations:
+    argocd.argoproj.io/sync-wave: "15"
+  finalizers:
+    - resources-finalizer.argocd.argoproj.io
+spec:
+  project: default
+  source:
+    repoURL: {{ $.Values.global.repoUrl }}
+    targetRevision: {{ $.Values.global.targetRevision }}
+    path: charts/demo-suite-config
+    helm:
+      valueFiles:
+        - values.yaml
+        - values-{{ $.Values.global.environment }}.yaml
+      # Derived values (domain, hostname) come from this parent's values
+      # (configuration/ via the CMP in homelab) so the child's committed values
+      # files stay PII-free. valuesObject overrides valueFiles in ArgoCD.
+      valuesObject:
+        global:
+          domain: {{ $.Values.global.domain }}
+        {{- with $app.config }}
+        {{- toYaml . | nindent 8 }}
+        {{- end }}
+  destination:
+    server: https://kubernetes.default.svc
+    namespace: {{ $app.namespace }}
+  syncPolicy:
+    {{- if $.Values.global.automatedSync }}
+    automated:
+      prune: true
+      selfHeal: true
+    {{- end }}
+    syncOptions:
+      - CreateNamespace=true
+      - ServerSideApply=true
+      - SkipDryRunOnMissingResource=true
+{{- end }}
+{{- end }}
