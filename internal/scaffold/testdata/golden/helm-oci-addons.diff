diff --git a/configuration/templates/helm-addons.tmpl b/configuration/templates/helm-addons.tmpl
--- a/configuration/templates/helm-addons.tmpl
+++ b/configuration/templates/helm-addons.tmpl
@@ -15,3 +15,63 @@
 {{- if $localdev }}
   replicaCount: 1
 {{- end }}
+
+# ============================================================================
+# demo-oci - upstream Helm chart (scaffolded)
+# homelab scaffold app demo-oci --pattern helm --tier addons --chart-repo oci://ghcr.io/example/charts --chart-version 0.1.0 --wave 11
+# Sync Wave: 11
+# ============================================================================
+
+demo-oci:
+  enabled: true
+  namespace: demo-oci
+
+  # ArgoCD source: repoURL (no oci:// scheme for OCI registries), chart name and
+  # version. configuration/versions.yaml charts.demo-oci is the only place to bump it.
+  chart:
+    name: demo-oci
+    repo: ghcr.io/example/charts
+    version: "{{ index .Versions.Charts "demo-oci" }}"
+
+  # Handed verbatim to the upstream chart (spec.source.helm.values), in the
+  # `helm create` layout most charts follow: rename the keys to what the
+  # chart's own values.yaml expects.
+  values:
+{{- if $localdev }}
+    # Kind sizing: one replica, small footprint
+    replicaCount: 1
+    resources:
+      requests:
+        cpu: 50m
+        memory: 64Mi
+      limits:
+        cpu: 250m
+        memory: 256Mi
+{{- else }}
+    resources:
+      requests:
+        cpu: 100m
+        memory: 128Mi
+      limits:
+        cpu: 500m
+        memory: 512Mi
+{{- end }}
+    httpRoute:
+      enabled: true
+      annotations:
+        external-dns.alpha.kubernetes.io/hostname: {{ .Values.DEMO_OCI_HOSTNAME.Value }}
+      parentRefs:
+        - group: gateway.networking.k8s.io
+          kind: Gateway
+          name: {{ .Values.GATEWAY_INTERNAL.Value }}
+          namespace: {{ .Values.GATEWAY_NAMESPACE.Value }}
+          sectionName: https
+      hostnames:
+        - {{ .Values.DEMO_OCI_HOSTNAME.Value }}
+
+  # PostSync smoke hook (charts/addons/templates/_smoke.tpl): curl the
+  # in-cluster Service after sync; expect lists the accepted HTTP codes.
+  smoke:
+    enabled: true
+    url: http://demo-oci.demo-oci.svc.cluster.local:80/
+    expect: ["200"]
