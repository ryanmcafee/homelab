@@ -0,0 +1,33 @@
+# demo-oci
+
+Pattern: upstream Helm chart (helm), parent chart `charts/addons`. Scaffolded with:
+
+```bash
+homelab scaffold app demo-oci --pattern helm --tier addons --chart-repo oci://ghcr.io/example/charts --chart-version 0.1.0 --wave 11
+```
+
+## Generated
+
+| Path | Purpose |
+|------|---------|
+| `charts/addons/templates/demo-oci.yaml` | ArgoCD Application(s): demo-oci |
+| `charts/addons/values.yaml` | placeholder values block |
+| `configuration/schema/network.schema.yaml` | `DEMO_OCI_HOSTNAME` hostname key |
+| `configuration/templates/helm-addons.tmpl` | values for every environment (version, sizing, hostname, smoke URL) |
+| `configuration/versions.yaml` | chart version with its Renovate marker |
+| `tests/e2e/demo-oci/chainsaw-test.yaml` | chainsaw e2e test |
+
+## Before the first PR
+
+- [ ] Adapt the `values:` block in `configuration/templates/helm-addons.tmpl` to the chart's own values
+- [ ] Check that `smoke.url` (`http://demo-oci.demo-oci.svc.cluster.local:80/`) names the chart's Service and port
+- [ ] Seed any Secret 1Password provides in homelab in `localdev/fakes/secrets.yaml`
+- [ ] Replace this checklist with what the app does and how to operate it
+
+## Verify
+
+```bash
+task verify:text                                   # level 0
+task localdev:up && task verify:text LEVEL=2       # Kind: Healthy + Succeeded, e2e
+task test:e2e -- --test-dir tests/e2e/demo-oci
+```
diff --git a/tests/e2e/demo-oci/chainsaw-test.yaml b/tests/e2e/demo-oci/chainsaw-test.yaml
new file mode 100644
--- /dev/null
+++ b/tests/e2e/demo-oci/chainsaw-test.yaml
@@ -0,0 +1,138 @@
+---
+# Scaffolded by `homelab scaffold app demo-oci`; see tests/e2e/README.md.
+apiVersion: chainsaw.kyverno.io/v1alpha1
+kind: Test
+metadata:
+  name: demo-oci
+spec:
+  description: >-
+    The demo-oci HTTPRoute is accepted by envoy-internal and demo-oci /
+    answers through it with Host demo-oci.homelab.local.
+  steps:
+    - name: applications-healthy
+      description: The ArgoCD Applications behind this test are Healthy and their last sync Succeeded.
+      try:
+        - assert:
+            resource:
+              apiVersion: argoproj.io/v1alpha1
+              kind: Application
+              metadata:
+                name: demo-oci
+                namespace: argocd
+              status:
+                health:
+                  status: Healthy
+                operationState:
+                  phase: Succeeded
+      catch:
+        - describe:
+            apiVersion: argoproj.io/v1alpha1
+            kind: Application
+            name: demo-oci
+            namespace: argocd
+    - name: route-demo-oci
+      description: The demo-oci HTTPRoute is Accepted by envoy-internal and its backend refs resolve.
+      try:
+        - assert:
+            resource:
+              apiVersion: gateway.networking.k8s.io/v1
+              kind: HTTPRoute
+              metadata:
+                name: demo-oci
+                namespace: demo-oci
+              status:
+                (parents[?parentRef.name == 'envoy-internal']):
+                  - (conditions[?type == 'Accepted']):
+                      - status: "True"
+                    (conditions[?type == 'ResolvedRefs']):
+                      - status: "True"
+      catch:
+        - describe:
+            apiVersion: gateway.networking.k8s.io/v1
+            kind: HTTPRoute
+            name: demo-oci
+            namespace: demo-oci
+    - name: curl-demo-oci
+      description: >-
+        A curl Job must get one of [200]
+        from https://demo-oci.homelab.local/ via envoy-internal.envoy-gateway-system.svc.cluster.local.
+      timeouts:
+        assert: 5m
+      try:
+        - apply:
+            resource:
+              apiVersion: batch/v1
+              kind: Job
+              metadata:
+                name: curl-demo-oci
+              spec:
+                backoffLimit: 0
+                activeDeadlineSeconds: 300
+                template:
+                  spec:
+                    restartPolicy: Never
+                    securityContext:
+                      runAsNonRoot: true
+                      runAsUser: 100
+                      seccompProfile:
+                        type: RuntimeDefault
+                    containers:
+                      - name: curl
+                        # pinned from configuration/versions.yaml images.curl
+                        image: curlimages/curl:8.22.0
+                        securityContext:
+                          allowPrivilegeEscalation: false
+                          capabilities:
+                            drop: ["ALL"]
+                        resources:
+                          requests:
+                            cpu: 10m
+                            memory: 32Mi
+                          limits:
+                            cpu: 100m
+                            memory: 64Mi
+                        env:
+                          - name: HOST
+                            value: "demo-oci.homelab.local"
+                          - name: GATEWAY
+                            value: "envoy-internal.envoy-gateway-system.svc.cluster.local"
+                          - name: URL_PATH
+                            value: "/"
+                          - name: EXPECT
+                            value: "200"
+                          - name: ATTEMPTS
+                            value: "20"
+                        command: ["sh", "-c"]
+                        args:
+                          - |
+                            set -u
+                            i=1
+                            while [ "$i" -le "$ATTEMPTS" ]; do
+                              code=$(curl -sk -o /dev/null -w '%{http_code}' -L --max-redirs 5 --max-time 20 \
+                                --connect-to "$HOST:443:$GATEWAY:443" --connect-to "$HOST:80:$GATEWAY:80" \
+                                "https://$HOST$URL_PATH")
+                              echo "attempt $i/$ATTEMPTS: HTTP $code for https://$HOST$URL_PATH via $GATEWAY"
+                              for ok in $EXPECT; do [ "$code" = "$ok" ] && exit 0; done
+                              i=$((i + 1))
+                              sleep 6
+                            done
+                            echo "giving up: last HTTP code $code, expected one of: $EXPECT"
+                            exit 1
+        - assert:
+            resource:
+              apiVersion: batch/v1
+              kind: Job
+              metadata:
+                name: curl-demo-oci
+              status:
+                succeeded: 1
+      catch:
+        - events: {}
+        - podLogs:
+            selector: job-name=curl-demo-oci
+            tail: 50
+        - describe:
+            apiVersion: argoproj.io/v1alpha1
+            kind: Application
+            name: demo-oci
+            namespace: argocd
