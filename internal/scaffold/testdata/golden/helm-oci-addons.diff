--- /dev/null
+++ b/charts/addons/templates/demo-oci.yaml
@@ -0,0 +1,85 @@
+{{- /*
+demo-oci (helm pattern), scaffolded by:
+  homelab scaffold app demo-oci --pattern helm --tier addons --chart-repo oci://ghcr.io/example/charts --chart-version 0.1.0 --wave 11
+Chart, version, values and smoke URL come from the `demo-oci:` block of
+configuration/templates/helm-addons.tmpl; charts/addons/values.yaml only holds
+placeholders. See docs/apps/demo-oci.md.
+*/}}
+{{- $app := index .Values "demo-oci" }}
+{{- if $app.enabled }}
+{{- /*
+One Application with the upstream chart and a PostSync smoke hook; there is no
+demo-oci-config child. Add charts/demo-oci-config (and a demo-oci-config
+Application in a different wave) only when the app needs objects the upstream
+chart cannot render, e.g. a static PV for existing data (see sonarr).
+*/}}
+---
+# Namespace demo-oci: nothing else renders it, and the smoke Job below
+# lands in it before the Application's CreateNamespace=true would.
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: {{ $app.namespace }}
+  annotations:
+    argocd.argoproj.io/sync-wave: "-1"
+---
+# ArgoCD repository credential for the OCI registry (anonymous pull). ArgoCD only
+# pulls OCI charts from a registry it has a repository Secret for
+# (rule gitops/<env>/repo-secrets).
+apiVersion: v1
+kind: Secret
+metadata:
+  name: demo-oci-oci
+  namespace: argocd
+  labels:
+    argocd.argoproj.io/secret-type: repository
+  annotations:
+    argocd.argoproj.io/sync-wave: "-1"
+stringData:
+  name: demo-oci
+  type: helm
+  url: {{ $app.chart.repo }}
+  enableOCI: "true"
+---
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: demo-oci
+  namespace: argocd
+  annotations:
+    argocd.argoproj.io/sync-wave: "11"
+  finalizers:
+    - resources-finalizer.argocd.argoproj.io
+spec:
+  project: default
+  source:
+    repoURL: {{ $app.chart.repo }}
+    chart: {{ $app.chart.name }}
+    targetRevision: {{ $app.chart.version | quote }}
+    helm:
+      releaseName: demo-oci
+      {{- with $app.values }}
+      values: |
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+  destination:
+    server: https://kubernetes.default.svc
+    namespace: {{ $app.namespace }}
+
+  syncPolicy:
+    {{- if $.Values.global.automatedSync }}
+    automated:
+      prune: true
+      selfHeal: true
+    {{- end }}
+    syncOptions:
+      - CreateNamespace=true
+      - ServerSideApply=true
+    retry:
+      limit: 5
+      backoff:
+        duration: 5s
+        factor: 2
+        maxDuration: 3m
+{{- include "homelab.smokeJob" (dict "name" "demo-oci" "namespace" $app.namespace "smoke" $app.smoke "wave" "11" "image" $.Values.global.images.curl) }}
+{{- end }}
