+        cpu: 100m
+        memory: 128Mi
+      limits:
+        cpu: 500m
+        memory: 512Mi
+{{- end }}
+    ingress:
+      enabled: true
+      className: {{ .Values.INGRESS_CLASS_INTERNAL.Value }}
+      annotations:
+        cert-manager.io/cluster-issuer: letsencrypt
+      hosts:
