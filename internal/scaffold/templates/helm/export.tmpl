[[- template "blockHeader" . ]]

[[ .Name ]]:
  enabled: true
  namespace: [[ .Namespace ]]
[[- template "chartValues" . ]]
    version: "{{ index .Versions.Charts "[[ .Name ]]" }}"
[[- if .TrueCharts ]]

  # Handed verbatim to the upstream chart (spec.source.helm.values), in the
  # TrueCharts common-library layout (compare the sonarr block).
  values:
    workload:
      main:
        podSpec:
{{- if $localdev }}
          # Kind nodes run the host architecture (arm64 on Apple Silicon). Drop the
          # TrueCharts common default kubernetes.io/arch=amd64 pin; null deletes the
          # key when helm merges values, so the pod schedules on any node.
          nodeSelector:
            kubernetes.io/arch: null
{{- end }}
          containers:
            main:
              resources:
                requests:
                  cpu: 100m
                  memory: 128Mi
                limits:
                  cpu: 500m
                  memory: 512Mi
    persistence:
      config:
        enabled: true
        storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
        size: 1Gi
    route:
      main:
        enabled: true
        kind: HTTPRoute
        annotations:
          external-dns.alpha.kubernetes.io/hostname: {{ .Values.[[ .HostnameKey ]].Value }}
        parentRefs:
          - group: gateway.networking.k8s.io
            kind: Gateway
            name: {{ .Values.GATEWAY_INTERNAL.Value }}
            namespace: {{ .Values.GATEWAY_NAMESPACE.Value }}
            sectionName: https
        hostnames:
          - {{ .Values.[[ .HostnameKey ]].Value }}
    TZ: {{ .Values.TIMEZONE.Value }}
[[- else ]]

  # Handed verbatim to the upstream chart (spec.source.helm.values), in the
  # `helm create` layout most charts follow: rename the keys to what the
  # chart's own values.yaml expects.
  values:
[[- template "genericResources" . ]]
    httpRoute:
      enabled: true
      annotations:
        external-dns.alpha.kubernetes.io/hostname: {{ .Values.[[ .HostnameKey ]].Value }}
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: {{ .Values.GATEWAY_INTERNAL.Value }}
          namespace: {{ .Values.GATEWAY_NAMESPACE.Value }}
          sectionName: https
      hostnames:
        - {{ .Values.[[ .HostnameKey ]].Value }}
[[- end ]]
[[- template "smokeValues" . ]]
