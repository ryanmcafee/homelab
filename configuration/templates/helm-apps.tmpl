          paths:
            - path: /
              pathType: Prefix
      tls:
        - secretName: sonarr-tls
          hosts:
            - {{ .Values.SONARR_HOSTNAME.Value }}

  TZ: {{ .Values.TIMEZONE.Value }}
  securityContext:
    container:
      runAsUser: {{ .Values.MEDIA_APP_UID.Value }}
      runAsGroup: {{ .Values.MEDIA_APP_GID.Value }}
