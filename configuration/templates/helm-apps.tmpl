# Applications Chart - {{ .Set | title }} Environment Values

# ============================================================================
# Global Configuration
# ============================================================================

global:
  # Environment identifier
  environment: {{ .Set }}

  # Base domain for ingress resources
  domain: {{ .Values.DOMAIN.Value }}

  # Git repository for local charts
  repoUrl: https://github.com/ryanmcafee/homelab.git
  targetRevision: main

  # Default storage class for persistent volumes
  storageClass: {{ .Values.STORAGE_CLASS_NFS.Value }}

  # Default ingress class
  ingressClassName: {{ .Values.INGRESS_CLASS.Value }}

  # Timezone for applications
  timezone: {{ .Values.TIMEZONE.Value }}

  # Media storage configuration (multiple NFS paths)
  media:
    nfsServer: {{ .Values.TRUENAS_HOSTNAME.Value }}
    movies: {{ .Values.MEDIA_MOVIES_PATH.Value }}
    tv: {{ .Values.MEDIA_TV_PATH.Value }}
    music: {{ .Values.MEDIA_MUSIC_PATH.Value }}
    pictures: {{ .Values.MEDIA_PICTURES_PATH.Value }}
    documents: {{ .Values.MEDIA_DOCUMENTS_PATH.Value }}
    downloads: {{ .Values.MEDIA_DOWNLOADS_PATH.Value }}
    books: {{ .Values.MEDIA_BOOKS_PATH.Value }}

# ============================================================================
# Plex Media Server
# Sync Wave: 1 (core media service)
# ============================================================================

plex:
  enabled: true
  namespace: media

  # Official Plex helm chart
  chart:
    name: plex-media-server
    repo: https://raw.githubusercontent.com/plexinc/pms-docker/gh-pages
    version: {{ index .Versions.Charts "plex-media-server" }}

  image:
    registry: index.docker.io
    repository: plexinc/pms-docker
    tag: latest
    pullPolicy: IfNotPresent

  # GPU configuration (NVIDIA Quadro P2200)
  runtimeClassName: nvidia  # For GPU transcoding

  # Node selector for GPU-enabled nodes
  nodeSelector:
    feature.node.kubernetes.io/pci-10de.present: "true"

  # Plex configuration
  pms:
    configExistingClaim: "{{ .Values.PLEX_CONFIG_PVC.Value }}"
    storageClassName: democratic-csi-iscsi
    # Plex claim token from 1Password
    claimSecret:
      name: plex
      key: plex-claim-token
    # NVIDIA GPU for hardware transcoding
    gpu:
      nvidia:
        enabled: true
    resources:
      requests:
        cpu: 4000m
        memory: 16Gi
      limits:
        cpu: 4000m
        memory: 16Gi

  # Persistence configuration
  persistence:
    config:
      enabled: true
      storageClass: {{ .Values.STORAGE_CLASS_SSD.Value }}
      size: 100Gi
      accessMode: ReadWriteOnce

    # Transcode directory (ephemeral for performance)
    transcode:
      enabled: true
      storageClass: ""
      accessMode: ReadWriteOnce
      size: 20Gi
      # Use emptyDir for better performance
      emptyDir:
        enabled: true
        medium: Memory
        sizeLimit: 10Gi

  # Service configuration
  service:
    type: LoadBalancer
    port: 32400
    externalTrafficPolicy: Local
    annotations:
      io.cilium/lb-ipam-ips: "{{ .Values.PLEX_LB_IP.Value }}"
      port-forwarding.{{ .Values.DOMAIN.Value }}/enable: "true"

  # Extra volumes for media storage via NFS
  extraVolumes:
    - name: movies
      nfs:
        server: {{ .Values.TRUENAS_HOSTNAME.Value }}
        path: {{ .Values.MEDIA_MOVIES_PATH.Value }}
    - name: tv
      nfs:
        server: {{ .Values.TRUENAS_HOSTNAME.Value }}
        path: {{ .Values.MEDIA_TV_PATH.Value }}
    - name: music
      nfs:
        server: {{ .Values.TRUENAS_HOSTNAME.Value }}
        path: {{ .Values.MEDIA_MUSIC_PATH.Value }}
    - name: pictures
      nfs:
        server: {{ .Values.TRUENAS_HOSTNAME.Value }}
        path: {{ .Values.MEDIA_PICTURES_PATH.Value }}

  extraVolumeMounts:
    - name: movies
      mountPath: /movies
      readOnly: false
    - name: tv
      mountPath: /tv
      readOnly: false
    - name: music
      mountPath: /music
      readOnly: false
    - name: pictures
      mountPath: /pictures
      readOnly: false

  # Ingress configuration
  ingress:
    enabled: true
    ingressClassName: {{ .Values.INGRESS_CLASS.Value }}
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt
      external-dns.alpha.kubernetes.io/hostname: {{ .Values.PLEX_HOSTNAME.Value }}
    hosts:
      - host: {{ .Values.PLEX_HOSTNAME.Value }}
        paths:
          - path: /
            pathType: Prefix
    tls:
      - secretName: plex-tls
        hosts:
          - {{ .Values.PLEX_HOSTNAME.Value }}

  # Environment variables
  extraEnv:
    TZ: {{ .Values.TIMEZONE.Value }}
    ADVERTISE_IP: https://{{ .Values.PLEX_HOSTNAME.Value }}:443
    PLEX_UID: "{{ .Values.MEDIA_APP_UID.Value }}"
    PLEX_GID: "{{ .Values.MEDIA_APP_GID.Value }}"
    CHANGE_CONFIG_DIR_OWNERSHIP: "false"

