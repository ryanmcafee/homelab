# Applications Chart - {{ .Set }} Environment Values
#
# GENERATED FILE — do not edit. Source: configuration/templates/helm-apps.tmpl
# rendered with configuration/environments/{{ .Set }}.yaml.
# Regenerate: homelab config export --set {{ .Set }} --format helm-apps

# ============================================================================
# Global Configuration
# ============================================================================

global:
  # Environment identifier
  environment: {{ .Set }}

  # Base domain for ingress resources
  domain: {{ .Values.DOMAIN.Value }}

  # Git repository for local charts
  repoUrl: https://github.com/ryanmcafee/homelab.git
  # homelab: main is what production tracks. localdev: a placeholder that the
  # parent Application overrides through helm.valuesObject with the PR head
  # (scripts/localdev-argocd.ts install --revision).
  targetRevision: main

  # Whether every Application syncs automatically (prune + selfHeal). Off where
  # the working tree is pushed with `argocd app sync --local` (ARGOCD_AUTOMATED_SYNC).
  automatedSync: {{ $automated }}

  # Images shared by the chart's own templates (PostSync smoke Jobs).
  images:
    curl: "{{ index .Versions.Images "curl" }}"

  # Default storage class for persistent volumes
  storageClass: {{ .Values.STORAGE_CLASS_NFS.Value }}

  # Default ingress classes
  ingressClassNameExternal: {{ .Values.INGRESS_CLASS_EXTERNAL.Value }}
  ingressClassNameInternal: {{ .Values.INGRESS_CLASS_INTERNAL.Value }}

  # Timezone for applications
  timezone: {{ .Values.TIMEZONE.Value }}

  # iSCSI target portal (IP:port) handed to the *-config child charts via
  # helm.valuesObject
  iscsi:
    portal: "{{ .Values.ISCSI_TARGET_PORTAL.Value }}"

  # Media storage configuration (multiple NFS paths)
  media:
    nfsServer: {{ .Values.TRUENAS_HOSTNAME.Value }}
    movies: {{ .Values.MEDIA_MOVIES_PATH.Value }}
    tv: {{ .Values.MEDIA_TV_PATH.Value }}
    music: {{ .Values.MEDIA_MUSIC_PATH.Value }}
    pictures: {{ .Values.MEDIA_PICTURES_PATH.Value }}
    documents: {{ .Values.MEDIA_DOCUMENTS_PATH.Value }}
    downloads: {{ .Values.MEDIA_DOWNLOADS_PATH.Value }}
    books: {{ .Values.MEDIA_BOOKS_PATH.Value }}

# ============================================================================
# Plex Media Server
# Sync Wave: 1 (core media service)
# ============================================================================

plex:
  enabled: true
  namespace: media

  # Official Plex helm chart
  chart:
    name: plex-media-server
    repo: https://raw.githubusercontent.com/plexinc/pms-docker/gh-pages
    version: {{ index .Versions.Charts "plex-media-server" }}

  image:
    registry: index.docker.io
    repository: plexinc/pms-docker
    tag: latest
    pullPolicy: IfNotPresent

{{- if eq .Values.GPU_VENDOR.Value "nvidia" }}

  # GPU configuration (NVIDIA Quadro P2200)
  runtimeClassName: nvidia  # For GPU transcoding

  # Node selector for GPU-enabled nodes.
  # NFD's default PCI label format is pci-<class>_<vendor>.present where 0300
  # is the PCI class code for "Display controller" and 10de is NVIDIA's vendor
  # ID. Using the short pci-10de.present form would never match because NFD
  # only emits the long form.
  nodeSelector:
    feature.node.kubernetes.io/pci-0300_10de.present: "true"
{{- else if eq .Values.GPU_VENDOR.Value "intel" }}

  # Node selector for GPU-enabled nodes. The Intel GPU device plugin's
  # `intel-gpu-platform-labeling` NodeFeatureRule sets
  # `intel.feature.node.kubernetes.io/gpu=true` on every node where the plugin
  # successfully identifies an Intel GPU — strictly better than the generic PCI
  # vendor label because it confirms the device plugin actually recognized the
  # GPU (not just that a PCI device with vendor 8086 exists). The
  # GpuDevicePlugin CR uses this same label as its own nodeSelector, so Plex
  # aligns with the canonical Intel-side convention.
  nodeSelector:
    intel.feature.node.kubernetes.io/gpu: "true"
{{- end }}

  # GPU vendor selection (from GPU_VENDOR config flag)
  gpu:
    vendor: "{{ .Values.GPU_VENDOR.Value }}"

  # Plex configuration
  pms:
{{- if $csi }}
    # The static iSCSI claim comes from the plex-config child chart.
    configExistingClaim: "{{ .Values.PLEX_CONFIG_PVC.Value }}"
    storageClassName: democratic-csi-iscsi
{{- else }}
    # No static claim without democratic-csi: the chart provisions its own
    # PVC in the configured class (STORAGE_PROVIDER).
    storageClassName: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
{{- end }}
    # Plex claim token from 1Password
    claimSecret:
      name: plex
      key: plex-claim-token
{{- if eq .Values.GPU_VENDOR.Value "nvidia" }}
    # NVIDIA GPU for hardware transcoding
    gpu:
      nvidia:
        enabled: true
{{- end }}
{{- if $localdev }}
    # Kind sizing
    resources:
      requests:
        cpu: 100m
        memory: 512Mi
      limits:
        cpu: 1000m
        memory: 1Gi
{{- else }}
    resources:
      requests:
        cpu: 4000m
        memory: 16Gi
      limits:
        cpu: 4000m
        memory: 16Gi
{{- end }}
    # NOTE: gpu.intel.com/xe resource limit intentionally NOT set yet.
    # The intel-gpu-device-plugin DaemonSet is Running on talos-lz1-3u1 but is
    # not advertising gpu.intel.com/xe in node allocatable (plugin logs cut off
    # after "GPU (i915/xe) resource share count = 1" with no advertisement
    # events; likely Talos /dev/dri/by-path layout incompatibility). Plex gets
    # /dev/dri via the hostPath mount in plex.yaml's Intel branch and uses the
    # GPU directly via the xe driver. Re-add the resource limit once the
    # device plugin actually advertises the resource.

  # Persistence configuration
  persistence:
    config:
      enabled: true
      storageClass: {{ .Values.STORAGE_CLASS_SSD.Value }}
      size: 100Gi
      accessMode: ReadWriteOnce

    # Transcode directory (ephemeral for performance)
    transcode:
      enabled: true
      storageClass: ""
      accessMode: ReadWriteOnce
      size: 20Gi
      # Use emptyDir for better performance
      emptyDir:
        enabled: true
        medium: Memory
        sizeLimit: 10Gi

  # Service configuration
  service:
    type: {{ if $lb }}LoadBalancer{{ else }}NodePort{{ end }}
    port: 32400
    externalTrafficPolicy: Local
{{- if $lb }}
    annotations:
      io.cilium/lb-ipam-ips: "{{ .Values.PLEX_LB_IP.Value }}"
      port-forwarding.{{ .Values.DOMAIN.Value }}/enable: "true"
{{- end }}

  # Extra volumes for media storage (NFS exports, or emptyDirs where there is
  # no file server: MEDIA_PROVIDER)
  extraVolumes:
{{- if $nfsMedia }}
    - name: movies
      nfs:
        server: {{ .Values.TRUENAS_HOSTNAME.Value }}
        path: {{ .Values.MEDIA_MOVIES_PATH.Value }}
    - name: tv
      nfs:
        server: {{ .Values.TRUENAS_HOSTNAME.Value }}
        path: {{ .Values.MEDIA_TV_PATH.Value }}
    - name: music
      nfs:
        server: {{ .Values.TRUENAS_HOSTNAME.Value }}
        path: {{ .Values.MEDIA_MUSIC_PATH.Value }}
    - name: pictures
      nfs:
        server: {{ .Values.TRUENAS_HOSTNAME.Value }}
        path: {{ .Values.MEDIA_PICTURES_PATH.Value }}
{{- else }}
    - name: movies
      emptyDir: {}
    - name: tv
      emptyDir: {}
    - name: music
      emptyDir: {}
    - name: pictures
      emptyDir: {}
{{- end }}
  # NOTE: dev-dri volume + mount for Intel GPU is added by the Plex application
  # chart template (charts/applications/templates/plex.yaml) based on
  # .Values.plex.gpu.vendor == "intel". Don't append it here, or the structured-
  # merge diff against the rendered StatefulSet fails with "duplicate entries
  # for key [name=\"dev-dri\"]".

  extraVolumeMounts:
    - name: movies
      mountPath: /movies
      readOnly: false
    - name: tv
      mountPath: /tv
      readOnly: false
    - name: music
      mountPath: /music
      readOnly: false
    - name: pictures
      mountPath: /pictures
      readOnly: false
  # (dev-dri mount is also added by plex.yaml — see note above.)

  # Ingress configuration
  ingress:
    enabled: true
    ingressClassName: {{ .Values.INGRESS_CLASS_EXTERNAL.Value }}
    url: "https://{{ .Values.PLEX_HOSTNAME.Value }}"
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt
      external-dns.alpha.kubernetes.io/hostname: {{ .Values.PLEX_HOSTNAME.Value }}
      external-dns.alpha.kubernetes.io/target: {{ .Values.EXTERNAL_DNS_DEFAULT_TARGET.Value }}
    hosts:
      - host: {{ .Values.PLEX_HOSTNAME.Value }}
        paths:
          - path: /
            pathType: Prefix
    tls:
      - secretName: plex-tls
        hosts:
          - {{ .Values.PLEX_HOSTNAME.Value }}

  # Environment variables
  extraEnv:
    TZ: {{ .Values.TIMEZONE.Value }}
    ADVERTISE_IP: https://{{ .Values.PLEX_HOSTNAME.Value }}:443
    PLEX_UID: "{{ .Values.MEDIA_APP_UID.Value }}"
    PLEX_GID: "{{ .Values.MEDIA_APP_GID.Value }}"
    CHANGE_CONFIG_DIR_OWNERSHIP: "false"

  # PostSync smoke hook (charts/applications/templates/_smoke.tpl): curl the in-cluster
  # Service after sync; expect lists the accepted HTTP codes.
  smoke:
    enabled: true
    url: http://plex-plex-media-server.media.svc.cluster.local:32400/identity
    expect: ["200"]

