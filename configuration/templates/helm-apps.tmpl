          kubernetes.io/arch: null
{{- end }}
        containers:
          main:
            resources:
              requests:
                cpu: 100m
                memory: 256Mi
              limits:
                cpu: 500m
                memory: 512Mi

  persistence:
    config:
      enabled: true
{{- if $csi }}
      existingClaim: "{{ .Values.LAZYLIBRARIAN_CONFIG_PVC.Value }}"
{{- else }}
      storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
      size: 1Gi
{{- end }}

    # Books storage (NFS export, or an emptyDir without a file server)
    books:
      enabled: true
{{- if $nfsMedia }}
      type: nfs
      server: {{ .Values.TRUENAS_HOSTNAME.Value }}
      path: {{ .Values.MEDIA_BOOKS_PATH.Value }}
{{- else }}
      type: emptyDir
{{- end }}
      mountPath: /books

    # Downloads storage (NFS export, or an emptyDir without a file server)
    downloads:
      enabled: true
{{- if $nfsMedia }}
      type: nfs
      server: {{ .Values.TRUENAS_HOSTNAME.Value }}
      path: {{ .Values.MEDIA_DOWNLOADS_PATH.Value }}
{{- else }}
      type: emptyDir
{{- end }}
      mountPath: /downloads

  ingress:
    main:
      enabled: true
      ingressClassName: {{ .Values.INGRESS_CLASS_INTERNAL.Value }}
      annotations:
        cert-manager.io/cluster-issuer: letsencrypt
        external-dns.alpha.kubernetes.io/hostname: {{ .Values.LAZYLIBRARIAN_HOSTNAME.Value }}
      hosts:
        - host: {{ .Values.LAZYLIBRARIAN_HOSTNAME.Value }}
          paths:
            - path: /
              pathType: Prefix
      tls:
        - secretName: lazylibrarian-tls
          hosts:
            - {{ .Values.LAZYLIBRARIAN_HOSTNAME.Value }}

  TZ: {{ .Values.TIMEZONE.Value }}
  securityContext:
    container:
      runAsUser: {{ .Values.MEDIA_APP_UID.Value }}
      runAsGroup: {{ .Values.MEDIA_APP_GID.Value }}
    pod:
      fsGroup: {{ .Values.MEDIA_APP_GID.Value }}

  # PostSync smoke hook (charts/applications/templates/_smoke.tpl): curl the in-cluster
  # Service after sync; expect lists the accepted HTTP codes.
  smoke:
    enabled: true
    url: http://lazylibrarian.media.svc.cluster.local:5299/
    expect: ["200"]

# ============================================================================
# Home Assistant - Home Automation Hub
# Sync Wave: 3
# ============================================================================

homeassistant:
  enabled: false
  namespace: home-automation

  # TrueCharts helm chart (OCI registry)
  chart:
    name: home-assistant
    repo: oci://oci.trueforge.org/truecharts/home-assistant
    version: {{ index .Versions.Charts "home-assistant" }}

  workload:
    main:
      podSpec:
{{- if $localdev }}
        # Kind nodes run the host architecture (arm64 on Apple Silicon). Drop the
        # TrueCharts common default kubernetes.io/arch=amd64 pin; null deletes the
        # key when helm merges values, so the pod schedules on any node.
        nodeSelector:
          kubernetes.io/arch: null
{{- end }}
        hostNetwork: true
        containers:
          main:
            resources:
              requests:
                cpu: 500m
                memory: 1Gi
              limits:
                cpu: 2000m
                memory: 2Gi

  podOptions:
    dnsPolicy: ClusterFirstWithHostNet

  persistence:
    config:
      enabled: true
{{- if $csi }}
      existingClaim: "{{ .Values.HOMEASSISTANT_CONFIG_PVC.Value }}"
{{- else }}
      storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
      size: 1Gi
{{- end }}

  ingress:
    main:
      enabled: true
      ingressClassName: {{ .Values.INGRESS_CLASS_INTERNAL.Value }}
      annotations:
        cert-manager.io/cluster-issuer: letsencrypt
        external-dns.alpha.kubernetes.io/hostname: {{ .Values.HOMEASSISTANT_HOSTNAME.Value }}
      hosts:
        - host: {{ .Values.HOMEASSISTANT_HOSTNAME.Value }}
          paths:
            - path: /
              pathType: Prefix
      tls:
        - secretName: homeassistant-tls
          hosts:
            - {{ .Values.HOMEASSISTANT_HOSTNAME.Value }}

  TZ: {{ .Values.TIMEZONE.Value }}

  # PostSync smoke hook (charts/applications/templates/_smoke.tpl): curl the in-cluster
  # Service after sync; expect lists the accepted HTTP codes.
  smoke:
    enabled: true
    url: http://home-assistant.home-automation.svc.cluster.local:8123/api/
    expect: ["200", "401"]

# ============================================================================
# Mosquitto - MQTT Broker
# Sync Wave: 3
# ============================================================================

mosquitto:
  enabled: true
  namespace: home-automation

  # TrueCharts helm chart (OCI registry)
  chart:
    name: mosquitto
    repo: oci://oci.trueforge.org/truecharts/mosquitto
    version: {{ .Versions.Charts.mosquitto }}

  workload:
    main:
      podSpec:
{{- if $localdev }}
        # Kind nodes run the host architecture (arm64 on Apple Silicon). Drop the
        # TrueCharts common default kubernetes.io/arch=amd64 pin; null deletes the
        # key when helm merges values, so the pod schedules on any node.
        nodeSelector:
          kubernetes.io/arch: null
{{- end }}
        containers:
          main:
            resources:
              requests:
                cpu: 50m
                memory: 128Mi
              limits:
                cpu: 200m
                memory: 256Mi

  persistence:
    config:
      enabled: true
{{- if $csi }}
      existingClaim: "{{ .Values.MOSQUITTO_CONFIG_PVC.Value }}"
{{- else }}
      storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
      size: 1Gi
{{- end }}
      mountPath: /mosquitto/config

    data:
      enabled: true
{{- if $csi }}
      existingClaim: "{{ .Values.MOSQUITTO_DATA_PVC.Value }}"
{{- else }}
      storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
      size: 1Gi
{{- end }}
      mountPath: /mosquitto/data

    configinc:
      enabled: true
{{- if $csi }}
      existingClaim: "{{ .Values.MOSQUITTO_CONFIGINC_PVC.Value }}"
{{- else }}
      storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
      size: 1Gi
{{- end }}
      mountPath: /mosquitto/configinc

  # The TrueCharts common library refuses a NodePort Service without an
  # explicit nodePort, so without LoadBalancer addresses both listeners get a
  # fixed port in the Kind range (30000-32767; ArgoCD uses 30080).
  service:
    main:
      type: {{ if $lb }}LoadBalancer{{ else }}NodePort{{ end }}
      ports:
        main:
          port: {{ .Values.MOSQUITTO_MQTT_PORT.Value }}
          targetPort: {{ .Values.MOSQUITTO_MQTT_PORT.Value }}
{{- if not $lb }}
          nodePort: 31883
{{- end }}
          protocol: tcp
    websockets:
      enabled: true
      type: {{ if $lb }}LoadBalancer{{ else }}NodePort{{ end }}
      ports:
        websockets:
          enabled: true
          port: {{ .Values.MOSQUITTO_WEBSOCKET_PORT.Value }}
          targetPort: {{ .Values.MOSQUITTO_WEBSOCKET_PORT.Value }}
{{- if not $lb }}
          nodePort: 31901
{{- end }}
          protocol: tcp

  # Authentication configuration
  mosquitto:
    auth:
      enabled: true

  TZ: {{ .Values.TIMEZONE.Value }}

  # PostSync smoke hook (charts/applications/templates/_smoke.tpl): curl the in-cluster
  # Service after sync; expect lists the accepted HTTP codes.
  smoke:
    enabled: false  # MQTT only, no HTTP endpoint to probe

# ============================================================================
# FlareSolverr - Cloudflare Protection Bypass Proxy
# Sync Wave: 12 (before Prowlarr at wave 13)
# ============================================================================

flaresolverr:
  enabled: true
  namespace: media

  # TrueCharts helm chart (OCI registry)
  chart:
    name: flaresolverr
    repo: oci://oci.trueforge.org/truecharts/flaresolverr
    version: {{ .Versions.Charts.flaresolverr }}

  workload:
    main:
      podSpec:
{{- if $localdev }}
        # Kind nodes run the host architecture (arm64 on Apple Silicon). Drop the
        # TrueCharts common default kubernetes.io/arch=amd64 pin; null deletes the
        # key when helm merges values, so the pod schedules on any node.
        nodeSelector:
          kubernetes.io/arch: null
{{- end }}
        containers:
          main:
            env:
              BROWSER_TIMEOUT: 40000
              HEADLESS: true
              LOG_LEVEL: info
