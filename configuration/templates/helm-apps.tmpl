# ============================================================================
# NZBGet - Usenet Downloader
# Sync Wave: 13
# ============================================================================

nzbget:
  enabled: true
  namespace: media

  # TrueCharts helm chart (OCI registry)
  chart:
    name: nzbget
    repo: oci://oci.trueforge.org/truecharts/nzbget
    version: {{ .Versions.Charts.nzbget }}

  workload:
    main:
      podSpec:
{{- if $localdev }}
        # Kind nodes run the host architecture (arm64 on Apple Silicon). Drop the
        # TrueCharts common default kubernetes.io/arch=amd64 pin; null deletes the
        # key when helm merges values, so the pod schedules on any node.
        nodeSelector:
          kubernetes.io/arch: null
{{- end }}
        containers:
          main:
            # NOTE: nzbget v26 made `MainDir` and `ScriptDir` REQUIRED and
            # renamed the bundled 7-zip from /usr/bin/7za to /usr/bin/7z.
            # nzbget v26 rejects the dotted `-o Section.Key=value` CLI
            # override syntax, so we cannot pass these as args from the chart.
            # The PVC at /config/nzbget.conf is hand-fixed (lines 11/71/1533).
            resources:
              # Bumped from 256Mi/1Gi → 512Mi/2Gi → 1Gi/4Gi as nzbget v26 kept
              # OOMing on smaller limits. At 1Gi: dead in 7s during startup.
              # At 2Gi: survives ~88s into active unrar of large files before
              # OOMKill. v26's par2 + unpack subsystems hold the entire output
              # buffer in memory while extracting, so peaks track the largest
              # file in the archive set (4K BluRay REMUX easily exceeds 2Gi).
              requests:
                cpu: 100m
                memory: 1Gi
              limits:
                cpu: 1000m
                memory: 4Gi

  persistence:
    config:
      enabled: true
{{- if $csi }}
      existingClaim: "{{ .Values.NZBGET_CONFIG_PVC.Value }}"
{{- else }}
      storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
      size: 1Gi
{{- end }}

    # Downloads storage (NFS export, or an emptyDir without a file server)
    downloads:
      enabled: true
{{- if $nfsMedia }}
      type: nfs
      server: {{ .Values.TRUENAS_HOSTNAME.Value }}
      path: {{ .Values.MEDIA_DOWNLOADS_PATH.Value }}
{{- else }}
      type: emptyDir
{{- end }}
      mountPath: /downloads

  ingress:
    main:
      enabled: true
      ingressClassName: {{ .Values.INGRESS_CLASS_INTERNAL.Value }}
      annotations:
        cert-manager.io/cluster-issuer: letsencrypt
        external-dns.alpha.kubernetes.io/hostname: {{ .Values.NZBGET_HOSTNAME.Value }}
      hosts:
        - host: {{ .Values.NZBGET_HOSTNAME.Value }}
          paths:
            - path: /
              pathType: Prefix
      tls:
        - secretName: nzbget-tls
          hosts:
            - {{ .Values.NZBGET_HOSTNAME.Value }}

  TZ: {{ .Values.TIMEZONE.Value }}
  securityContext:
    container:
      runAsUser: {{ .Values.MEDIA_APP_UID.Value }}
      runAsGroup: {{ .Values.MEDIA_APP_GID.Value }}
    pod:
      fsGroup: {{ .Values.MEDIA_APP_GID.Value }}

  # PostSync smoke hook (charts/applications/templates/_smoke.tpl): curl the in-cluster
  # Service after sync; expect lists the accepted HTTP codes.
  smoke:
    enabled: true
    url: http://nzbget.media.svc.cluster.local:10057/
    expect: ["200", "401"]

