# Homelab Ansible inventory — GENERATED, do not edit.
# Source: configuration/templates/ansible-inventory.tmpl rendered with
# configuration/environments/{{ .Set }}.yaml. Regenerate: task ansible:inventory

all:
  children:
    # Proxmox hypervisor
    proxmox:
      hosts:
        proxmox-node:
          ansible_host: {{ .Values.PROXMOX_IP.Value }}
          ansible_user: root
          ansible_ssh_private_key_file: ~/.ssh/id_ed25519
          ansible_python_interpreter: /usr/bin/python3
          ipmi_host: "{{ if .Values.IPMI_IP }}{{ .Values.IPMI_IP.Value }}{{ end }}"
          ipmi_user: ADMIN

    # TrueNAS storage server
    truenas:
      hosts:
        truenas-server:
          ansible_host: {{ .Values.TRUENAS_IP.Value }}
          ansible_user: root
          ansible_ssh_private_key_file: ~/.ssh/id_ed25519
          truenas_api_url: https://{{ .Values.TRUENAS_IP.Value }}
      vars:
        # truenas_api_key comes from group_vars/truenas.yml (env lookup, no address)
        truenas_hostname: {{ .Values.TRUENAS_HOSTNAME.Value }}
        nfs_mapall_user: {{ .Values.NFS_MAPALL_USER.Value }}
        truenas_static_ip: "{{ .Values.TRUENAS_IP.Value }}/24"
        truenas_gateway: "{{ .Values.GATEWAY_IP.Value }}"
        truenas_dns_servers:
          - "{{ .Values.GATEWAY_IP.Value }}"
        # Optional (TRUENAS_LAN_IP); empty skips the LAN interface tasks
        truenas_lan_static_ip: "{{ if .Values.TRUENAS_LAN_IP }}{{ .Values.TRUENAS_LAN_IP.Value }}{{ end }}"
        truenas_nfs_allowed_networks:
          - "{{ .Values.NFS_SHARE_ALLOW.Value }}"
        # truenas-full-setup.yml talks to Proxmox to (re)boot the VM
        proxmox_host: "{{ .Values.PROXMOX_IP.Value }}"
        acme_email: "{{ .Values.ACME_EMAIL.Value }}"

    # Talos Kubernetes cluster (reference only; managed through Terragrunt/talosctl)
    #
    # The control-plane hosts come from .ControlPlane, the resolver's derived
    # address list (ADR-035). .Ordinal is the CPn_IP capture group, so the host
    # name stays cp-1/cp-2/... without this template restating the key-name rule.
    talos:
      hosts:
{{- range .ControlPlane }}
        cp-{{ .Ordinal }}:
          ansible_host: {{ .Address }}
{{- end }}
        worker-1:
          ansible_host: {{ .Values.WORKER1_IP.Value }}
        worker-2:
          ansible_host: {{ .Values.WORKER2_IP.Value }}
        worker-3:
          ansible_host: {{ .Values.WORKER3_IP.Value }}
      vars:
        ansible_connection: local  # Talos is managed via API, not SSH

  vars:
    # Network facts every role reads (group_vars/all.yml keeps only non-PII settings)
    base_domain: {{ .Values.DOMAIN.Value }}
    homelab_vlan: 100
    homelab_subnet: {{ .Values.NFS_SHARE_ALLOW.Value }}
    homelab_gateway: {{ .Values.GATEWAY_IP.Value }}
    dns_servers:
      - {{ .Values.GATEWAY_IP.Value }}
    timezone: {{ .Values.TIMEZONE.Value }}
