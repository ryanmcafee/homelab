# ============================================================================
# Tailscale Operator - Tailnet subnet router (homelab advertiser)
# Sync Wave: operator at 2, config (operator-oauth OnePasswordItem) at 1
# ============================================================================

tailscale-operator:
  # The operator OAuth client comes from 1Password (operator-oauth secret).
  enabled: {{ $onepassword }}
  namespace: tailscale
  hostname: tailscale-operator-homelab

  chart:
    name: tailscale-operator
    repo: https://pkgs.tailscale.com/helmcharts
    version: "{{ index .Versions.Charts "tailscale-operator" }}"

  # 1Password vault path for the operator OAuth client (creates secret: operator-oauth)
  onePasswordItemPath: {{ .Values.TAILSCALE_OPERATOR_1P_PATH.Value }}

  # Connector subnet-router config — consumed by the Connector in Plan 03.
  # CIDR is PII, routed through the CMP config key (not a committed literal).
  connector:
    advertiseRoutes:
      - "{{ .Values.TAILSCALE_ADVERTISE_ROUTES.Value }}"
    tags:
      - "tag:k8s"

  resources:
    requests:
      memory: 112Mi
    limits:
      memory: 192Mi

# ============================================================================
# Agent Read-Only Access - ServiceAccount + ClusterRoles agents use through the
# Tailscale API server proxy (no Secrets, no write verbs). Enabled in every
# environment; tests/e2e/agent-readonly proves the RBAC in Kind.
# Sync Wave: Namespace at 1, Application at 2. docs/runbooks/readonly-access.md
# ============================================================================

agentReadonly:
  enabled: true
  namespace: agent-access

# ============================================================================
# Local Path Provisioner - Kind storage (homelab uses democratic-csi)
# ============================================================================

local-path-provisioner:
  enabled: {{ eq .Values.STORAGE_PROVIDER.Value "local-path" }}
  namespace: local-path-storage

  chart:
    name: local-path-provisioner
    repo: https://charts.containeroo.ch
    version: {{ index .Versions.Charts "local-path-provisioner" }}

  # The class every STORAGE_CLASS_* key points at when STORAGE_PROVIDER is local-path.
  storageClass:
    name: {{ .Values.STORAGE_CLASS_NFS.Value }}
    defaultClass: true

# ============================================================================
# 1Password Operator - Secret Management
# Sync Wave: 2
# ============================================================================

1password-operator:
  enabled: {{ $onepassword }}
  namespace: onepassword-operator

  chart:
    name: connect
    repo: https://1password.github.io/connect-helm-charts
    version: {{ index .Versions.Charts "onepassword-connect" }}

  connect:
    credentialsJson: ""
    host: {{ .Values.OP_CONNECT_HOSTNAME.Value }}

  resources:
    operator:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi
    connect:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi

# ============================================================================
# CloudNativePG - PostgreSQL Operator
# Sync Wave: 10 inside addons; the addons tier (wave 2) finishes before the
# applications tier (wave 3), so the CNPG CRDs exist before any consumer
# (home-assistant, #260)
# ============================================================================

cloudnative-pg:
  # Kind runs the operator too, so the CNPG e2e test (tests/e2e/cloudnative-pg)
  # and future consumers (#260) work against local-path volumes.
  enabled: true
  namespace: cnpg-system

  chart:
    name: cloudnative-pg
    repo: https://cloudnative-pg.github.io/charts
    version: {{ index .Versions.Charts "cloudnative-pg" }}
{{- if $localdev }}

  # Kind sizing: one operator replica, small footprint
  replicaCount: 1

  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 250m
      memory: 256Mi
{{- else }}

  resources:
    requests:
      cpu: 100m
      memory: 64Mi
    limits:
      cpu: 500m
      memory: 96Mi
{{- end }}

  monitoring:
    podMonitorEnabled: true
    grafanaDashboard:
      create: false

# ============================================================================
# CloudNativePG Barman Cloud Plugin - Backup/Restore through an ObjectStore
# Sync Wave: 11 (after cert-manager [0], which issues its TLS, and cloudnative-pg [10])
# ============================================================================

cnpg-barman-cloud:
  # Enabled wherever cloudnative-pg is (the template requires both). The
  # weekly restore drill (tests/drills/cnpg-restore, restore-drill.yml) backs
  # a Kind Cluster up through it and restores it; production has no object
  # store yet (docs/disaster-recovery.md, "Verified claims").
  enabled: true
  namespace: cnpg-system

  chart:
    name: plugin-barman-cloud
    repo: https://cloudnative-pg.github.io/charts
    version: {{ index .Versions.Charts "plugin-barman-cloud" }}
{{- if $localdev }}

  # Kind sizing
  resources:
    requests:
      cpu: 25m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi
{{- else }}

  resources:
    requests:
      cpu: 50m
      memory: 32Mi
    limits:
      cpu: 500m
      memory: 48Mi
{{- end }}

# ============================================================================
# Cert-Manager - TLS Certificate Management
# Sync Wave: 3
# ============================================================================

cert-manager:
  enabled: true
  namespace: cert-manager

  chart:
    name: cert-manager
    repo: https://charts.jetstack.io
    version: {{ index .Versions.Charts "cert-manager" }}

  installCRDs: true

  # When true the letsencrypt ClusterIssuer (cert-manager-cluster-issuer child
  # chart) is a self-signed issuer under the same name, so every
  # cert-manager.io/cluster-issuer: letsencrypt annotation keeps working on a
  # cluster without a public domain (CERT_ISSUER).
  selfSigned: {{ eq .Values.CERT_ISSUER.Value "selfsigned" }}

  # Production Let's Encrypt
  letsencrypt:
    enabled: true
    email: {{ .Values.ACME_EMAIL.Value }}
    server: https://acme-v02.api.letsencrypt.org/directory

  cloudflare:
    enabled: true
    email: {{ .Values.ACME_EMAIL.Value }}
    onePasswordItemPath: {{ .Values.CERT_MANAGER_1P_PATH.Value }}

  # DNS zones for certificate issuance
  dnsZones:
    - {{ .Values.DOMAIN.Value }}

  # Custom DNS resolvers for ACME DNS-01 challenge verification
  dns01RecursiveNameservers:
    - "1.1.1.1:53"
    - "8.8.8.8:53"
    - "8.8.4.4:53"
{{- if $localdev }}

  # Kind sizing
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 128Mi

  webhook:
    resources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        cpu: 50m
        memory: 64Mi

  cainjector:
    resources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        cpu: 100m
        memory: 128Mi
{{- else }}

  resources:
    requests:
      cpu: 50m
      memory: 48Mi
    limits:
      cpu: 200m
      memory: 80Mi

  webhook:
    resources:
      requests:
        cpu: 20m
        memory: 32Mi
      limits:
        cpu: 100m
        memory: 48Mi

  cainjector:
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 192Mi
{{- end }}

# ============================================================================
# External-DNS - Automatic DNS Record Management
# Sync Wave: 4
# ============================================================================

external-dns:
  enabled: {{ $externalDNS }}
  namespace: external-dns

  chart:
    name: external-dns
    repo: https://kubernetes-sigs.github.io/external-dns/
    version: {{ index .Versions.Charts "external-dns" }}

  provider: cloudflare

  # Only HTTPRoutes on the external Gateway publish to Cloudflare (e.g. Plex);
  # templates/external-dns-cloudflare.yaml sets the source and --gateway-name.

  cloudflare:
    apiToken: ""
    proxied: true
    onePasswordItemPath: {{ .Values.EXTERNAL_DNS_1P_PATH.Value }}

  domainFilters:
    - {{ .Values.DOMAIN.Value }}

  annotationFilter: external-dns.alpha.kubernetes.io/hostname

  # Default target for all DNS records - use DuckDNS for dynamic IP
  # This creates CNAME records pointing to the DDNS hostname
  defaultTarget: {{ .Values.EXTERNAL_DNS_DEFAULT_TARGET.Value }}

  resources:
    requests:
      cpu: 20m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 48Mi

# ============================================================================
# External-DNS UniFi - Internal DNS Management (Split DNS)
# Sync Wave: 4
# ============================================================================

external-dns-unifi:
  enabled: {{ $externalDNS }}
  namespace: external-dns-unifi

  chart:
    version: "{{ index .Versions.Charts "external-dns" }}"

  webhook:
    version: "{{ index .Versions.Charts "external-dns-webhook-unifi" }}"

  unifi:
    host: "https://{{ .Values.GATEWAY_IP.Value }}"

  # Uses existing UniFi credentials (needs api_key field added)
  onePasswordItemPath: {{ .Values.EXTERNAL_DNS_UNIFI_1P_PATH.Value }}

  domainFilters:
    - {{ .Values.DOMAIN.Value }}

  resources:
    requests:
      cpu: 20m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 48Mi

  webhookResources:
    requests:
      memory: 64Mi
    limits:
      memory: 96Mi

# ============================================================================
# Kube-Prometheus-Stack - Monitoring and Alerting
# Sync Wave: 5
# ============================================================================

kube-prometheus-stack:
  enabled: true
  namespace: monitoring

  chart:
    name: kube-prometheus-stack
    repo: https://prometheus-community.github.io/helm-charts
    version: {{ index .Versions.Charts "kube-prometheus-stack" }}

  prometheus:
{{- if $localdev }}
    # Kind sizing: short retention, small volume
    retention: 1d
    retentionSize: 4GB
    storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
    storageSize: 5Gi

    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi
{{- else }}
    retention: 30d
    retentionSize: 50GB
    storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
    storageSize: 100Gi

    resources:
      requests:
        cpu: 500m
        memory: 4Gi
      limits:
        cpu: 2000m
        memory: 6Gi
{{- end }}

    # Avoid scheduling on GPU nodes — keep GPU resources for media workloads
    affinity:
      nodeAffinity:
        requiredDuringSchedulingIgnoredDuringExecution:
          nodeSelectorTerms:
            - matchExpressions:
                - key: nvidia.com/gpu.present
                  operator: NotIn
                  values:
                    - "true"

    serviceMonitors:
      enabled: true

  grafana:
    enabled: true
    # With a secret store the password comes from 1Password; without one a
    # fixed dev password is the only way to log in.
    adminPassword: "{{ if not $onepassword }}admin{{ end }}"

    # Run as apps:users (568:100) to match NFS PVC permissions
    securityContext:
      runAsUser: {{ .Values.MEDIA_APP_UID.Value }}
      runAsGroup: {{ .Values.MEDIA_APP_GID.Value }}
      fsGroup: {{ .Values.MEDIA_APP_GID.Value }}

    persistence:
      enabled: true
      # The static iSCSI claim (grafana-config chart) only exists with democratic-csi;
      # otherwise the chart provisions a dynamic claim in storageClass.
      existingClaim: "{{ if $csi }}{{ .Values.GRAFANA_CONFIG_PVC.Value }}{{ end }}"
      storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
      size: {{ if $localdev }}1Gi{{ else }}10Gi{{ end }}

    # HTTPRoute on the internal Gateway (GATEWAY_INTERNAL).
    route:
      enabled: true
      hostname: {{ .Values.GRAFANA_HOSTNAME.Value }}

    resources:
      requests:
        cpu: {{ if $localdev }}50m{{ else }}100m{{ end }}
        memory: {{ if $localdev }}128Mi{{ else }}256Mi{{ end }}
      limits:
        cpu: {{ if $localdev }}200m{{ else }}500m{{ end }}
        memory: {{ if $localdev }}256Mi{{ else }}768Mi{{ end }}
{{- if not $localdev }}

    sidecarResources:
      requests:
        memory: 112Mi
      limits:
        memory: 192Mi
{{- end }}

    # ClickHouse datasource for the cluster logs (docs/logging.md). Grafana
    # installs the plugin at startup and reads the password of the read-only
    # ClickHouse user from Secret logging.secrets.grafana.
    clickhousePlugin: "{{ index .Versions.Images "grafana-clickhouse-datasource" }}"

    # grafana.com dashboards the Grafana init container downloads into the
    # "homelab" folder; revisions are pinned. The ClickHouse operator chart
    # ships its own dashboards as sidecar ConfigMaps, and so does
    # charts/grafana-config for Envoy Gateway and the ingress overview.
    dashboards:
      opentelemetry-collector:
        gnetId: 15983
        revision: 30
{{- if $cilium }}
      istio-control-plane:
        gnetId: 7645
        revision: 332
      istio-mesh:
        gnetId: 7639
        revision: 333
      istio-service:
        gnetId: 7636
        revision: 332
      istio-workload:
        gnetId: 7630
        revision: 333
      istio-ztunnel:
        gnetId: 21306
        revision: 100
      cilium-agent:
        gnetId: 16611
        revision: 1
      cilium-operator:
        gnetId: 16612
        revision: 1
      hubble:
        gnetId: 16613
        revision: 1
      hubble-network-overview:
        gnetId: 19424
        revision: 1
      hubble-dns-overview:
        gnetId: 19425
        revision: 1
{{- end }}

  # Alertmanager and node-exporter are not useful in Kind (no alert routes, containerised nodes).
  alertmanager:
    enabled: {{ not $localdev }}
    # Notification receivers (docs/runbooks/alerting.md): critical -> Pushover
    # high priority, warning -> Pushover low priority, info and Watchdog ->
    # nowhere. The Pushover token and user key are the 1Password item
    # ALERTMANAGER_1P_PATH, which the prometheus-config chart turns into Secret
    # <secretName> in the monitoring namespace; Alertmanager mounts it and reads
    # the *_file fields. Without a secret store nothing is mounted and every
    # route ends in the null receiver.
    notifications:
      enabled: {{ and (not $localdev) $onepassword }}
      secretName: alertmanager-notifications
      onePasswordItemPath: "{{ if $onepassword }}{{ .Values.ALERTMANAGER_1P_PATH.Value }}{{ end }}"
    # HTTPRoute on the internal Gateway (GATEWAY_INTERNAL).
    route:
      enabled: true
      hostname: {{ .Values.ALERTMANAGER_HOSTNAME.Value }}
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 10Gi

    resources:
      requests:
        cpu: 50m
        memory: 32Mi
      limits:
        cpu: 200m
        memory: 48Mi

  nodeExporter:
    enabled: {{ not $localdev }}
    resources:
      requests:
        memory: 32Mi
      limits:
        memory: 48Mi
{{- if not $localdev }}

  operator:
    resources:
      requests:
        memory: 48Mi
      limits:
        memory: 80Mi

  configReloader:
    resources:
      requests:
        memory: 32Mi
      limits:
        memory: 48Mi
{{- end }}

  # The chart's CPUThrottlingHigh divides throttled CFS periods by the periods a
  # container ran in at all, with no floor under the denominator. A container
  # that is 99 % idle runs in ~30 of the 3000 periods in five minutes, so a
  # handful of throttled bursts reads as 30 % and the alert never clears — that
  # is how 16 alerts stood on democratic-csi for three months. The tuned copy in
  # additionalPrometheusRulesMap adds the missing floor.
  defaultRules:
    disabled:
      CPUThrottlingHigh: true

  kubeStateMetrics:
    enabled: true
    resources:
      requests:
        memory: {{ if $localdev }}128Mi{{ else }}48Mi{{ end }}
      limits:
        memory: {{ if $localdev }}256Mi{{ else }}80Mi{{ end }}

  # kube-proxy scrape and the KubeProxyDown rule. With Cilium as the kube-proxy
  # replacement there is no kube-proxy DaemonSet: the scrape Service has no
  # endpoints and KubeProxyDown (absent(up{job="kube-proxy"})) fires forever.
  kubeProxy:
    enabled: {{ not $kubeProxyReplacement }}

  # etcd scrape on <control-plane IP>:2381 (Talos cluster.etcd.extraArgs
  # listen-metrics-urls). Kind runs etcd inside the control-plane container with
  # no reachable metrics endpoint, so the scrape is off there.
  #
  # .ControlPlane is the resolver's derived address list (ADR-035), ascending by
  # ordinal — one endpoint per member the ConfigSet declares, whether that is one
  # or seven. Naming CP1/CP2/CP3 here is what used to pin the scrape to this
  # cluster's shape.
  kubeEtcd:
    port: 2381
{{- if $localdev }}
    endpoints: []
{{- else }}
    endpoints:
{{- range .ControlPlane }}
      - {{ .Address }}
{{- end }}
{{- end }}

  # PostSync smoke hooks (charts/addons/templates/_smoke.tpl): curl the
  # in-cluster Services after sync; expect lists the accepted HTTP codes.
  # Service names follow the chart's <release>-grafana / <release>-prometheus.
  smoke:
    grafana:
      enabled: true
      url: http://kube-prometheus-stack-grafana.monitoring.svc.cluster.local:80/api/health
      expect: ["200"]
    prometheus:
      enabled: true
      url: http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090/-/ready
      expect: ["200"]

# ============================================================================
# Gateway API CRDs (standard channel) for Envoy Gateway, the Istio gateways
# and waypoints
# Sync Wave: 1
# ============================================================================

gatewayApi:
  enabled: true
  repo: https://github.com/kubernetes-sigs/gateway-api.git
  version: "{{ index .Versions.Charts "gateway-api" }}"

# ============================================================================
# Envoy Gateway - internal and external ingress (docs/networking.md)
# Sync Waves: 4 CRDs, 5 controller, 6 envoy-gateway-config (both Gateways)
# Routes attach to the https listener of GATEWAY_INTERNAL or GATEWAY_EXTERNAL.
# ============================================================================

envoy-gateway:
  enabled: true
  namespace: {{ .Values.GATEWAY_NAMESPACE.Value }}

  chart:
    repo: docker.io/envoyproxy
    version: "{{ index .Versions.Charts "envoy-gateway" }}"

  controller:
    replicas: {{ if $localdev }}1{{ else }}2{{ end }}
    serviceMonitor: true
    resources:
      requests:
        cpu: {{ if $localdev }}50m{{ else }}100m{{ end }}
        memory: {{ if $localdev }}128Mi{{ else }}256Mi{{ end }}
      limits:
        cpu: "1"
        memory: 1Gi

  gateways:
    # LAN and tailnet: every internal hostname (external-dns-unifi publishes
    # its routes to UniFi DNS).
    internal:
      enabled: true
      config:
        name: {{ .Values.GATEWAY_INTERNAL.Value }}
        service:
{{- if $lb }}
          type: LoadBalancer
          staticIP: "{{ .Values.GATEWAY_INTERNAL_STATIC_IP.Value }}"
{{- else }}
          type: ClusterIP
{{- end }}
{{- if $localdev }}
        replicas: 1
        autoscaling:
          enabled: false
        resources:
          requests:
            cpu: 50m
            memory: 64Mi
          limits:
            cpu: 500m
            memory: 256Mi
{{- else }}
        replicas: 2
        autoscaling:
          enabled: true
          minReplicas: 2
          maxReplicas: 3
          targetCPUUtilizationPercentage: 80
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: "1"
            memory: 512Mi
{{- end }}
        tracing:
          enabled: {{ $logging }}
          samplingRate: {{ if $localdev }}100{{ else }}10{{ end }}

    # Internet: WAN 80/443 are port-forwarded to its static IP; external-dns
    # publishes its routes to Cloudflare.
    external:
      enabled: true
      config:
        name: {{ .Values.GATEWAY_EXTERNAL.Value }}
        service:
{{- if $lb }}
          type: LoadBalancer
          staticIP: "{{ .Values.GATEWAY_EXTERNAL_STATIC_IP.Value }}"
          annotations:
            port-forwarding.{{ .Values.DOMAIN.Value }}/enable: "true"
{{- else }}
          type: ClusterIP
{{- end }}
{{- if $localdev }}
        replicas: 1
        autoscaling:
          enabled: false
        resources:
          requests:
            cpu: 50m
            memory: 64Mi
          limits:
            cpu: 500m
            memory: 256Mi
{{- else }}
        replicas: 2
        autoscaling:
          enabled: true
          minReplicas: 2
          maxReplicas: 3
          targetCPUUtilizationPercentage: 80
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: "1"
            memory: 512Mi
{{- end }}
        tracing:
          enabled: {{ $logging }}
          samplingRate: {{ if $localdev }}100{{ else }}10{{ end }}

# ============================================================================
# UniFi Port Forwarding Controller - Automatic Port Forwards
# Sync Wave: 6-7
# ============================================================================

unifi-port-forward:
  # Needs LoadBalancer addresses to forward to and UniFi credentials from 1Password.
  enabled: {{ and $lb $onepassword }}
  namespace: port-forwarding
  chart:
    version: {{ index .Versions.Charts "unifi-port-forward" }}
  onePasswordItemPath: {{ .Values.UNIFI_PORT_FORWARD_1P_PATH.Value }}

# ============================================================================
# OAuth2-Proxy - Zero-Trust Authentication (DISABLED)
# Sync Wave: 6-8
# ============================================================================

oauth2-proxy:
  enabled: false
  namespace: oauth2-proxy

  chart:
    version: "{{ index .Versions.Charts "oauth2-proxy" }}"

  # External route auth.<DOMAIN>; Cloudflare CNAMEs it to this target.
  externalDNSTarget: {{ .Values.EXTERNAL_DNS_DEFAULT_TARGET.Value }}

  # 1Password paths for secrets
  googleOAuthPath: {{ .Values.GOOGLE_OAUTH_1P_PATH.Value }}
  cookieSecretPath: vaults/homelab/items/oauth2-proxy-cookie

  # Allowed email domains for authentication
  emailDomains:
    - "{{ .Values.DOMAIN.Value }}"

  # Cookie and whitelist domains
  cookieDomains:
    - ".{{ .Values.DOMAIN.Value }}"
  whitelistDomains:
    - ".{{ .Values.DOMAIN.Value }}"

  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi

# ============================================================================
# NVIDIA GPU Operator - GPU Support for Kubernetes
# Sync Wave: 0 (must deploy before Plex which requires RuntimeClass nvidia)
# ============================================================================

nvidia-gpu-operator:
  enabled: {{ eq .Values.GPU_VENDOR.Value "nvidia" }}
  namespace: gpu-operator

  chart:
    version: "{{ index .Versions.Charts "nvidia-gpu-operator" }}"

  # Note: Driver and toolkit are provided by Talos system extensions
  # (siderolabs/nonfree-kmod-nvidia and siderolabs/nvidia-container-toolkit)
  # GPU Operator only manages device plugin, monitoring, and feature discovery

# ============================================================================
# Intel GPU Device Plugin - GPU Support for Kubernetes (Intel)
# Sync Wave: 10 (same as NVIDIA GPU operator, mutually exclusive via GPU_VENDOR)
# ============================================================================

intel-gpu-device-plugin:
  enabled: {{ eq .Values.GPU_VENDOR.Value "intel" }}
  namespace: intel-device-plugins

  chart:
    name: intel-device-plugins-gpu
    repo: https://intel.github.io/helm-charts
    version: "{{ index .Versions.Charts "intel-device-plugins-gpu" }}"

# ============================================================================
# Intel Device Plugins Operator - installs CRDs + reconciler for GpuDevicePlugin
# Sync Wave: 9 (before the intel-gpu-device-plugin chart at wave 10)
# Gated on GPU_VENDOR=intel — operator only matters when the Intel plugin is on.
# ============================================================================

intel-device-plugins-operator:
  enabled: {{ eq .Values.GPU_VENDOR.Value "intel" }}
  namespace: intel-device-plugins

  chart:
    name: intel-device-plugins-operator
    repo: https://intel.github.io/helm-charts
    version: "{{ index .Versions.Charts "intel-device-plugins-operator" }}"

  resources:
    requests:
      memory: 32Mi
    limits:
      memory: 48Mi

# ============================================================================
# NodeFeatureDiscovery - hardware feature labeling
# Sync Wave: 9 (before intel-gpu-device-plugin / nvidia-gpu-operator at wave 10)
# Always enabled regardless of GPU_VENDOR — it is a general-purpose label source
# and the prerequisite for the Intel GPU device plugin's NodeFeatureRule match.
# ============================================================================

node-feature-discovery:
  enabled: true
  namespace: node-feature-discovery

  chart:
    name: node-feature-discovery
    repo: https://kubernetes-sigs.github.io/node-feature-discovery/charts
    version: "{{ index .Versions.Charts "node-feature-discovery" }}"

# ============================================================================
# Argo Workflows - Workflow Orchestration
# Sync Wave: 9 (after core infrastructure)
# ============================================================================

argo-workflows:
  # Kind sizing: not part of the localdev component set.
  enabled: {{ not $localdev }}
  namespace: argo-workflows

  chart:
    name: argo-workflows
    repo: https://argoproj.github.io/argo-helm
    version: "{{ index .Versions.Charts "argo-workflows" }}"

  server:
    authMode: server

    # HTTPRoute on the internal Gateway (GATEWAY_INTERNAL).
    route:
      enabled: true
      hostname: {{ .Values.WORKFLOWS_HOSTNAME.Value }}

    resources:
      requests:
        cpu: 50m
        memory: 32Mi
      limits:
        cpu: 200m
        memory: 48Mi

  controller:
    resources:
      requests:
        cpu: 100m
        memory: 32Mi
      limits:
        cpu: 500m
        memory: 48Mi

    workflowDefaults:
      spec:
        ttlStrategy:
          secondsAfterCompletion: 86400
          secondsAfterSuccess: 43200
          secondsAfterFailure: 172800

# ============================================================================
# Istio ambient mesh + Kiali (docs/service-mesh.md)
# Sync Waves: 2 istio-base, 3 istiod + istio-cni, 4 ztunnel, 5 istio-config,
# 10 kiali. No namespace is enrolled here: SERVICE_MESH_AMBIENT_NAMESPACES
# labels namespaces of the applications chart.
# ============================================================================

istio:
  # Runs wherever Cilium is the CNI: ambient needs its cni.exclusive=false and
  # socketLB.hostNamespaceOnly=true (the cilium block above).
  enabled: {{ $cilium }}
  namespace: istio-system
  chart:
    # The storage.googleapis.com repository ends at 1.30.5; 1.31 is published here.
    repo: https://blob.istio.io/istio-release/charts
    version: "{{ .Versions.Charts.istio }}"
  # Internal/external Gateways of classes istio-internal/istio-external next to
  # Envoy Gateway, for comparison only (charts/istio-gateways).
  gateways:
    enabled: true
    config:
      namespace: istio-ingress
      serviceType: {{ if $lb }}LoadBalancer{{ else }}ClusterIP{{ end }}
      echo:
        envoyGateway:
          name: {{ .Values.GATEWAY_INTERNAL.Value }}
          namespace: {{ .Values.GATEWAY_NAMESPACE.Value }}

  # Waypoint spans to the OpenTelemetry gateway collector (OTLP gRPC).
  # ztunnel is L4 only and emits no spans (docs/service-mesh.md).
  tracing:
    provider: otel-tracing
    service: otel-collector-gateway.observability.svc.cluster.local
    port: 4317
    samplingPercentage: {{ if $localdev }}100{{ else }}10{{ end }}

  istiod:
    replicas: 1
    resources:
      requests:
        cpu: {{ if $localdev }}50m{{ else }}100m{{ end }}
        memory: {{ if $localdev }}256Mi{{ else }}512Mi{{ end }}
      limits:
        cpu: "1"
        memory: 1Gi

  # Waypoint proxies, created only when a namespace asks for L7 policy.
  proxy:
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: "1"
        memory: 512Mi

  cni:
    cniBinDir: /opt/cni/bin
    cniConfDir: /etc/cni/net.d
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 500m
        memory: 256Mi

  ztunnel:
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: "1"
        memory: 512Mi

  kiali:
    enabled: true
    chart:
      name: kiali-server
      repo: https://kiali.org/helm-charts
      version: "{{ index .Versions.Charts "kiali-server" }}"
    hostname: {{ .Values.SERVICEMESH_HOSTNAME.Value }}
    prometheusUrl: http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090
    grafana:
      internalUrl: http://kube-prometheus-stack-grafana.monitoring.svc.cluster.local:80
      externalUrl: https://{{ .Values.GRAFANA_HOSTNAME.Value }}
    resources:
      requests:
        cpu: 10m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 1Gi
    smoke:
      enabled: true
      url: http://kiali.istio-system.svc.cluster.local:20001/healthz
      expect: ["200"]

# ============================================================================
# Cluster logs: OpenTelemetry collectors -> ClickHouse -> Grafana (docs/logging.md)
# Sync Waves: 8 clickhouse-dependencies, 10 clickhouse-operator,
# 11 clickhouse, 12 otel-collector-agent + otel-collector-cluster
# ============================================================================

logging:
  enabled: {{ $logging }}
  namespace: observability
  database: otel
  # 90 days. The exporter writes it as the otel_logs table TTL when it creates
  # the table; changing it later needs ALTER TABLE ... MODIFY TTL (docs/logging.md).
  retention: 2160h

  # Secrets with a `password` key: 1Password items in homelab
  # (charts/clickhouse-dependencies), localdev/fakes/secrets.yaml in Kind.
  secrets:
    otel: clickhouse-otel
    grafana: clickhouse-grafana
  dependencies:
    onePassword:
      enabled: {{ $onepassword }}
      otelItemPath: {{ .Values.CLICKHOUSE_OTEL_1P_PATH.Value }}
      grafanaItemPath: {{ .Values.CLICKHOUSE_GRAFANA_1P_PATH.Value }}

  clickhouse:
    # The operator names the Service of ClickHouseInstallation "logs" clickhouse-logs.
    host: clickhouse-logs.observability.svc.cluster.local
    endpoint: tcp://clickhouse-logs.observability.svc.cluster.local:9000?dial_timeout=10s
    operator:
      chart:
        name: altinity-clickhouse-operator
        repo: https://helm.altinity.com
        version: "{{ index .Versions.Charts "altinity-clickhouse-operator" }}"
      resources:
        requests:
          cpu: 50m
          memory: 64Mi
        limits:
          cpu: 500m
          memory: 256Mi
      metricsResources:
        requests:
          cpu: 20m
          memory: 64Mi
        limits:
          cpu: 200m
          memory: 256Mi
    # charts/clickhouse values (the parent passes them through valuesObject).
    server:
      image: "clickhouse/clickhouse-server:{{ index .Versions.Images "clickhouse-server" }}"
      # Block storage like the PostgreSQL clusters: ClickHouse fsyncs and
      # renames parts constantly, which NFS serves badly.
      storageClass: {{ .Values.STORAGE_CLASS_ISCSI_SSD.Value }}
      networkNames: "{{ .Values.NETWORK_NAMES.Value }}"
{{- if $localdev }}
      storageSize: 2Gi
      resources:
        requests:
          cpu: 100m
          memory: 512Mi
        limits:
          cpu: "1"
          memory: 1Gi
{{- else }}
      # 90 days of logs, traces, Hubble and UniFi flows; estimate in docs/logging.md.
      storageSize: 100Gi
      resources:
        requests:
          cpu: 250m
          memory: 2Gi
        limits:
          cpu: "2"
          memory: 4Gi
{{- end }}
    smoke:
      enabled: true
      url: http://clickhouse-logs.observability.svc.cluster.local:8123/ping
      expect: ["200"]

  otel:
    chart:
      name: opentelemetry-collector
      repo: https://open-telemetry.github.io/opentelemetry-helm-charts
      version: "{{ index .Versions.Charts "opentelemetry-collector" }}"
    # The contrib distribution carries the clickhouse exporter; the image tag
    # follows the chart's appVersion.
    image:
      repository: otel/opentelemetry-collector-contrib
      command: otelcol-contrib
    agent:
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi
    cluster:
      resources:
        requests:
          cpu: 20m
          memory: 64Mi
        limits:
          cpu: 200m
          memory: 256Mi
    # OTLP (traces, application logs) and the UniFi gateway's syslog/NetFlow.
    # Service otel-collector-gateway; with LoadBalancer addresses it also
    # takes OTEL_LB_IP so the gateway can reach it as otel.<DOMAIN>.
    gateway:
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: "1"
          memory: 512Mi
      # OTLP/HTTP (port 4318) with TLS for clients outside the cluster, on
      # the internal Gateway.
      route:
        enabled: true
        hostname: {{ .Values.OTLP_HOSTNAME.Value }}
{{- if $lb }}
      service:
        type: LoadBalancer
        annotations:
          io.cilium/lb-ipam-ips: "{{ .Values.OTEL_LB_IP.Value }}"
          external-dns.alpha.kubernetes.io/hostname: {{ .Values.OTEL_HOSTNAME.Value }}
        # Cilium drops anything from outside these ranges at the load balancer.
        loadBalancerSourceRanges: [{{ .Values.NFS_SHARE_ALLOW.Value }}{{ with .Values.OTEL_SOURCE_RANGES.Value }}, {{ . }}{{ end }}]
{{- end }}

  # UniFi gateway syslog (CEF) and NetFlow receivers on otel-collector-gateway.
  unifi:
    enabled: true
    gatewayIP: "{{ .Values.GATEWAY_IP.Value }}"

  # Filtered Hubble flow log (cilium hubble.export.static) read by the agents.
  # Hubble runs in the Talos Cilium values only.
  hubble:
    enabled: {{ and $cilium (not $localdev) }}
    flowLog: /var/run/cilium/hubble/events.log

# ============================================================================
# Blackbox probes - synthetic checks of the paperclip request path
# Sync Wave: 10 (docs/runbooks/paperclip-request-path.md)
# ============================================================================

blackbox-exporter:
  enabled: true
  namespace: monitoring
  chart:
    name: prometheus-blackbox-exporter
    repo: https://prometheus-community.github.io/helm-charts
    version: "{{ index .Versions.Charts "prometheus-blackbox-exporter" }}"
  # Every 15 s: through DNS and the internal Envoy Gateway (in-cluster, so the
  # LB address resolves but Cilium short-circuits it to the Envoy pods without
  # the L2/BGP hop) and straight to the pod's Service, so a failure names the hop.
  targets:
    - name: paperclip-ingress
      url: https://{{ .Values.PAPERCLIP_HOSTNAME.Value }}/api/health
      module: http_2xx_ingress
    - name: paperclip-direct
      url: http://paperclip.paperclip.svc.cluster.local:3100/api/health
      module: http_2xx

# ============================================================================
# GitHub pull request review alerts (templates/github-pr-exporter.yaml)
# Sync Wave: 10 (docs/runbooks/alerting.md)
# ============================================================================

{{- $githubPR := and $onepassword (eq .Values.GITHUB_PR_ALERTS_ENABLED.Value "true") }}
{{- $prExclude := .Values.GITHUB_PR_ALERTS_EXCLUDE.Value }}

github-pr-exporter:
  enabled: {{ $githubPR }}
  namespace: monitoring
  chart:
    name: prometheus-json-exporter
    repo: https://prometheus-community.github.io/helm-charts
    version: "{{ index .Versions.Charts "prometheus-json-exporter" }}"
  # Secret with field token (a read-only fine-grained PAT), created by the
  # prometheus-config chart from this 1Password item.
  secretName: github-pr-alerts
  onePasswordItemPath: "{{ if $onepassword }}{{ .Values.GITHUB_PR_ALERTS_1P_PATH.Value }}{{ end }}"
  scrapeInterval: {{ .Values.GITHUB_PR_ALERTS_SCRAPE_INTERVAL.Value }}
  repeatInterval: {{ .Values.GITHUB_PR_ALERTS_REPEAT_INTERVAL.Value }}
  # Both queries are scoped to the repositories of repoUrl's owner, who is also the reviewer.
  queries:
    - name: unreviewed
      url: "https://api.github.com/search/issues?q={{ urlquery (printf "%s user:%s %s" .Values.GITHUB_PR_ALERTS_QUERY_UNREVIEWED.Value $githubOwner $prExclude) }}&per_page=100"
    - name: review-requested
      url: "https://api.github.com/search/issues?q={{ urlquery (printf "%s user:%s review-requested:%s %s" .Values.GITHUB_PR_ALERTS_QUERY_REQUESTED.Value $githubOwner $githubOwner $prExclude) }}&per_page=100"

# ============================================================================
# Alert triage agent (templates/triage-agent.yaml, charts/triage-agent)
# Sync Wave: 10 (docs/runbooks/triage-agent.md)
# ============================================================================

{{- $triage := and $onepassword (eq .Values.TRIAGE_AGENT_ENABLED.Value "true") }}

triage-agent:
  enabled: {{ $triage }}
  namespace: triage-agent
  image: "ghcr.io/{{ $githubOwner }}/homelab-triage-agent:{{ index .Versions.Images "triage-agent" }}"
  # Secret triage-agent: CLAUDE_CODE_OAUTH_TOKEN plus optional fields (docs/runbooks/triage-agent.md).
  onePasswordItemPath: "{{ if $onepassword }}{{ .Values.TRIAGE_AGENT_1P_PATH.Value }}{{ end }}"
  memory:
    persistence:
      enabled: {{ eq .Values.TRIAGE_AGENT_MEMORY_PERSISTENCE.Value "true" }}
      storageClass: {{ .Values.STORAGE_CLASS_NFS.Value }}
