# ============================================================================
# UniFi Port Forwarding Controller - Automatic Port Forwards
# Sync Wave: 6-7
# ============================================================================

unifi-port-forward:
  enabled: true
  namespace: port-forwarding
  version: {{ index .Versions.Charts "unifi-port-forward" }}
  onePasswordItemPath: {{ .Values.UNIFI_PORT_FORWARD_1P_PATH.Value }}

# ============================================================================
# OAuth2-Proxy - Zero-Trust Authentication (DISABLED - replaced by Traefik OIDC plugin)
# Sync Wave: 6-8
# ============================================================================

oauth2-proxy:
  enabled: false
  namespace: oauth2-proxy

  chart:
    version: "{{ index .Versions.Charts "oauth2-proxy" }}"

  # 1Password paths for secrets
  googleOAuthPath: {{ .Values.TRAEFIK_GOOGLE_OAUTH_PATH.Value }}
  cookieSecretPath: vaults/homelab/items/oauth2-proxy-cookie

  # Allowed email domains for authentication
  emailDomains:
    - "{{ .Values.DOMAIN.Value }}"

  # Cookie and whitelist domains
  cookieDomains:
    - ".{{ .Values.DOMAIN.Value }}"
  whitelistDomains:
    - ".{{ .Values.DOMAIN.Value }}"

  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi

# ============================================================================
# NVIDIA GPU Operator - GPU Support for Kubernetes
# Sync Wave: 0 (must deploy before Plex which requires RuntimeClass nvidia)
# ============================================================================

nvidia-gpu-operator:
  enabled: {{ eq .Values.GPU_VENDOR.Value "nvidia" }}
  namespace: gpu-operator

  chart:
    version: "{{ index .Versions.Charts "nvidia-gpu-operator" }}"

  # Note: Driver and toolkit are provided by Talos system extensions
  # (siderolabs/nonfree-kmod-nvidia and siderolabs/nvidia-container-toolkit)
  # GPU Operator only manages device plugin, monitoring, and feature discovery

# ============================================================================
# Intel GPU Device Plugin - GPU Support for Kubernetes (Intel)
# Sync Wave: 10 (same as NVIDIA GPU operator, mutually exclusive via GPU_VENDOR)
# ============================================================================

intel-gpu-device-plugin:
  enabled: {{ eq .Values.GPU_VENDOR.Value "intel" }}
  namespace: intel-device-plugins

  chart:
    name: intel-device-plugins-gpu
    repo: https://intel.github.io/helm-charts
    version: "{{ index .Versions.Charts "intel-device-plugins-gpu" }}"

# ============================================================================
# Intel Device Plugins Operator - installs CRDs + reconciler for GpuDevicePlugin
# Sync Wave: 9 (before the intel-gpu-device-plugin chart at wave 10)
# Gated on GPU_VENDOR=intel — operator only matters when the Intel plugin is on.
# ============================================================================

intel-device-plugins-operator:
  enabled: {{ eq .Values.GPU_VENDOR.Value "intel" }}
  namespace: intel-device-plugins

  chart:
    name: intel-device-plugins-operator
    repo: https://intel.github.io/helm-charts
    version: "{{ index .Versions.Charts "intel-device-plugins-operator" }}"

# ============================================================================
# NodeFeatureDiscovery - hardware feature labeling
# Sync Wave: 9 (before intel-gpu-device-plugin / nvidia-gpu-operator at wave 10)
# Always enabled regardless of GPU_VENDOR — it is a general-purpose label source
# and the prerequisite for the Intel GPU device plugin's NodeFeatureRule match.
# ============================================================================

node-feature-discovery:
  enabled: true
  namespace: node-feature-discovery

  chart:
    name: node-feature-discovery
    repo: https://kubernetes-sigs.github.io/node-feature-discovery/charts
    version: "{{ index .Versions.Charts "node-feature-discovery" }}"

# ============================================================================
# Argo Workflows - Workflow Orchestration
# Sync Wave: 7 (after core infrastructure)
# ============================================================================

argo-workflows:
  enabled: true
  namespace: argo-workflows

  chart:
    name: argo-workflows
    repo: https://argoproj.github.io/argo-helm
    version: "{{ index .Versions.Charts "argo-workflows" }}"

  server:
    authMode: server

    ingress:
      enabled: true
      ingressClassName: {{ .Values.INGRESS_CLASS_INTERNAL.Value }}
      annotations:
        cert-manager.io/cluster-issuer: letsencrypt
        external-dns.alpha.kubernetes.io/hostname: {{ .Values.WORKFLOWS_HOSTNAME.Value }}
      hosts:
        - {{ .Values.WORKFLOWS_HOSTNAME.Value }}
      paths:
        - /
      pathType: Prefix
      tls:
        - secretName: argo-workflows-tls
          hosts:
            - {{ .Values.WORKFLOWS_HOSTNAME.Value }}

    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi

  controller:
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi

    workflowDefaults:
      spec:
        ttlStrategy:
          secondsAfterCompletion: 86400
          secondsAfterSuccess: 43200
          secondsAfterFailure: 172800

  # Ingress verification workflow configuration
  # NOTE: Disabled due to tpl() double-templating issues in upstream chart
  ingressVerification:
    enabled: false
    schedule: "*/5 * * * *"
    # List of ingresses to verify - all require authentication
    ingresses:
      - name: traefik
        url: https://{{ .Values.TRAEFIK_HOSTNAME.Value }}/dashboard/
        expectAuth: true
      - name: argocd
        url: https://{{ .Values.ARGOCD_HOSTNAME.Value }}
        expectAuth: true
      - name: grafana
        url: https://{{ .Values.GRAFANA_HOSTNAME.Value }}
        expectAuth: true
      - name: plex
        url: https://{{ .Values.PLEX_HOSTNAME.Value }}
        expectAuth: true
      - name: sonarr
        url: https://{{ .Values.SONARR_HOSTNAME.Value }}
        expectAuth: true
      - name: radarr
        url: https://{{ .Values.RADARR_HOSTNAME.Value }}
        expectAuth: true
      - name: prowlarr
        url: https://{{ .Values.PROWLARR_HOSTNAME.Value }}
        expectAuth: true
      - name: homeassistant
        url: https://{{ .Values.HOMEASSISTANT_HOSTNAME.Value }}
        expectAuth: true
      - name: auth
        url: https://{{ .Values.AUTH_HOSTNAME.Value }}
        expectAuth: true
