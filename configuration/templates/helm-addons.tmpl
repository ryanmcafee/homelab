# Addons Chart - {{ .Set }} Environment Values
#
# GENERATED FILE — do not edit. Source: configuration/templates/helm-addons.tmpl
# rendered with configuration/environments/{{ .Set }}.yaml.
# Regenerate: homelab config export --set {{ .Set }} --format helm-addons

# ============================================================================
# Global Configuration
# ============================================================================

global:
  # Environment identifier
  environment: {{ .Set }}

  # Base domain for ingress resources
  domain: {{ .Values.DOMAIN.Value }}

  # Default storage class for persistent volumes
  storageClass: {{ .Values.STORAGE_CLASS_NFS.Value }}

  # Git repository for SOPS secrets
  repoUrl: https://github.com/ryanmcafee/homelab.git
  # homelab: main is what production tracks. localdev: a placeholder that the
  # parent Application overrides through helm.valuesObject with the PR head
  # (scripts/localdev-argocd.ts install --revision).
  targetRevision: main

  # Whether every Application syncs automatically (prune + selfHeal). Off where
  # the working tree is pushed with `argocd app sync --local` (ARGOCD_AUTOMATED_SYNC).
  automatedSync: {{ $automated }}

  # Images shared by the chart's own templates (PostSync smoke Jobs).
  images:
    curl: "{{ index .Versions.Images "curl" }}"

  # iSCSI target portal handed to the *-config child charts (grafana-config,
  # prometheus-config) through the parent Application's helm.valuesObject.
  iscsi:
    portal: "{{ .Values.ISCSI_TARGET_PORTAL.Value }}"

# ============================================================================
# SOPS Secrets - Encrypted secrets for GitOps
# Sync Wave: -2 (FIRST - deploys 1Password credentials before operator)
# ============================================================================

sops-secrets:
  enabled: true

# ============================================================================
# ArgoCD - MOVED to charts/bootstrap/ at sync wave 1
# ============================================================================

argocd:
  enabled: false

# ============================================================================
# Kubelet CSR Approver - Automatic Kubelet Certificate Approval
# Sync Wave: 1 (early infrastructure component)
# ============================================================================

kubelet-csr-approver:
  enabled: true
  namespace: kube-system

  chart:
    name: kubelet-csr-approver
    repo: https://postfinance.github.io/kubelet-csr-approver
    version: "{{ index .Versions.Charts "kubelet-csr-approver" }}"

  # IP prefixes allowed for kubelet serving certificates
  # Must include all node IPs in the cluster
  providerIpPrefixes:
    - "{{ .Values.NFS_SHARE_ALLOW.Value }}"

  # Regex pattern for valid node names (Talos generates names like talos-xxx-yyy)
  providerRegex: "^talos-[a-z0-9]{3}-[a-z0-9]{3}$"

  # Bypass DNS resolution check for SAN names (Talos node names aren't in DNS)
  bypassDnsResolution: true

  # Maximum certificate validity (365 days)
  maxExpirationSeconds: 31536000

  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 128Mi

# ============================================================================
# metrics-server - metrics.k8s.io for kubectl top and the Traefik HPAs
# ============================================================================

metrics-server:
  enabled: true
  namespace: kube-system

  chart:
    name: metrics-server
    repo: https://kubernetes-sigs.github.io/metrics-server/
    version: "{{ index .Versions.Charts "metrics-server" }}"

  # Kind sizing: one replica; homelab keeps the aggregated API up through a drain.
  replicas: {{ if $localdev }}1{{ else }}2{{ end }}

  # Platform capability, not an environment branch (KUBELET_SERVING_CERT).
  kubeletInsecureTLS: {{ eq .Values.KUBELET_SERVING_CERT.Value "self-signed" }}

  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 256Mi

# ============================================================================
# Spegel - P2P image distribution; only the chart version comes from
# versions.yaml (the rest of charts/addons/values.yaml spegel block applies)
# ============================================================================

spegel:
  chart:
    version: "{{ index .Versions.Charts "spegel" }}"

# ============================================================================
# Cilium - CNI (adopted, not installed, by the Application)
# Sync Wave: 0
# homelab: Talos installs Cilium from inline manifests rendered with these values.
# Kind: scripts/localdev-kind.ts installs it with `helm upgrade --install` from
# cilium.values below. Either way the Application only adopts the release.
# ============================================================================

cilium:
  enabled: {{ $cilium }}
  chart:
    version: "{{ .Versions.Charts.cilium }}"  # task cilium:render reads the same key, so the inline manifest and this Application agree after the next `task render`

  # Helm values of the installed release. They must match what installed Cilium
  # (Talos inline manifests / localdev-kind.ts) or the Application shows a diff.
  values:
{{- if $localdev }}
    # Kind: no BGP, no L2 announcements, no Hubble; kube-proxy stays in place
    # and the API server is reached through the default Service.
    ipam:
      mode: kubernetes
    kubeProxyReplacement: {{ $kubeProxyReplacement }}
    operator:
      replicas: 1
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 1000m
        memory: 1Gi
    hubble:
      enabled: false
    image:
      pullPolicy: IfNotPresent
{{- else }}
    ipam:
      mode: kubernetes
    kubeProxyReplacement: {{ $kubeProxyReplacement }}
    k8sServiceHost: localhost
    k8sServicePort: 7445
    securityContext:
      capabilities:
        ciliumAgent:
          - CHOWN
          - KILL
          - NET_ADMIN
          - NET_RAW
          - IPC_LOCK
          - SYS_ADMIN
          - SYS_RESOURCE
          - DAC_OVERRIDE
          - FOWNER
          - SETGID
          - SETUID
        cleanCiliumState:
          - NET_ADMIN
          - SYS_ADMIN
          - SYS_RESOURCE
    cgroup:
      autoMount:
        enabled: false
      hostRoot: /sys/fs/cgroup
    l2announcements:
      enabled: true
    externalIPs:
      enabled: true
    bgpControlPlane:
      enabled: true
    hubble:
      relay:
        enabled: true
      ui:
        enabled: true
    bandwidthManager:
      enabled: true
      bbr: true
{{- end }}

# ============================================================================
# Cilium LB IPAM - LoadBalancer IP Management + BGP
# Sync Wave: 1
# ============================================================================

cilium-lb-ipam:
  # LB IPAM is a Cilium feature and only useful where LoadBalancer addresses exist.
  enabled: {{ and $cilium $lb }}

  lbipam:
    addresses:
      - "{{ .Values.LB_POOL_START.Value }}-{{ .Values.LB_POOL_END.Value }}"

  # Control Plane VIP - Only advertised by control-plane nodes
  # This creates a dedicated IP pool with restricted node selector
  controlPlaneVIP: "{{ .Values.CP_VIP.Value }}"

  bgp:
    enabled: true
    localASN: {{ .Values.BGP_K8S_ASN.Value }}
    peers:
      - name: "unifi-gateway"
        address: "{{ .Values.BGP_PEER_IP.Value }}"
        asn: {{ .Values.BGP_ROUTER_ASN.Value }}

# ============================================================================
# Democratic-CSI - NFS Storage Provisioner
# Sync Wave: 2
# ============================================================================

democratic-csi:
  enabled: {{ $csi }}
  namespace: democratic-csi

  chart:
    name: democratic-csi
    repo: https://democratic-csi.github.io/charts/
    version: {{ index .Versions.Charts "democratic-csi" }}

  driver: freenas-api-nfs

  truenas:
    # Use IP address instead of hostname since internal DNS is not resolvable from cluster
    endpoint: https://{{ .Values.TRUENAS_IP.Value }}
    allowInsecure: true  # Required when using IP (no valid TLS cert for IP)
    # 1Password vault path for TrueNAS API key (creates secret: truenas-api-key)
    onePasswordItemPath: {{ .Values.DEMOCRATIC_CSI_1P_PATH.Value }}

  nfs:
    shareHost: {{ .Values.TRUENAS_IP.Value }}
    shareAllow: {{ .Values.NFS_SHARE_ALLOW.Value }}
    parent: {{ .Values.TRUENAS_ZONE_PARENT.Value }}

  storageClasses:
    - name: {{ .Values.STORAGE_CLASS_NFS.Value }}
      defaultClass: true
      reclaimPolicy: Retain
      volumeBindingMode: Immediate
      allowVolumeExpansion: true
      parameters:
        fsType: nfs

  # The csi-driver containers idle at ~12m but work in short bursts, and a 200m
  # limit is a 20 ms quota per 100 ms period: too small for a burst, so 87 % of
  # the periods they ran in were throttled and CPUThrottlingHigh fired forever
  # (16 alerts, one per pod). The limit only caps a burst, so raising it costs
  # nothing; requests stay at 50m, so scheduling and node capacity are unchanged.
  resources:
    controller:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 1000m
        memory: 256Mi
    node:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 1000m
        memory: 256Mi

# ============================================================================
