        memory: 256Mi

# ============================================================================
# Democratic-CSI iSCSI - Block Storage Provisioner (SSD-backed)
# Sync Wave: 2 (same as NFS instances, reuses truenas-api-key secret)
# ============================================================================

democratic-csi-iscsi:
  enabled: {{ $csi }}
  namespace: democratic-csi

  chart:
    name: democratic-csi
    repo: https://democratic-csi.github.io/charts/
    version: {{ index .Versions.Charts "democratic-csi" }}

  driver: freenas-api-iscsi

  truenas:
    # Use IP address instead of hostname since internal DNS is not resolvable from cluster
