{{- /* Auto-generated by: homelab config export --format helm-addons */ -}}
{{- /* DO NOT EDIT — modify configuration/environments/{{ .Set }}.yaml instead */ -}}
# Addons Chart - {{ .Set }} Environment Values

# ============================================================================
# Global Configuration
# ============================================================================

global:
  # Environment identifier
  environment: {{ .Set }}

  # Base domain for ingress resources
  domain: {{ .Values.DOMAIN.Value }}

  # Default storage class for persistent volumes
  storageClass: {{ .Values.STORAGE_CLASS_NFS.Value }}

  # Enable external DNS management
  externalDNS: true

  # Enable external load balancing
  loadBalancer: true

  # Git repository for SOPS secrets
  repoUrl: https://github.com/ryanmcafee/homelab.git
  targetRevision: main

# ============================================================================
# SOPS Secrets - Encrypted secrets for GitOps
# Sync Wave: -2 (FIRST - deploys 1Password credentials before operator)
# ============================================================================

sops-secrets:
  enabled: true

# ============================================================================
# ArgoCD - MOVED to charts/bootstrap/ at sync wave 1
# ============================================================================

argocd:
  enabled: false

# ============================================================================
# Kubelet CSR Approver - Automatic Kubelet Certificate Approval
# Sync Wave: 1 (early infrastructure component)
# ============================================================================

kubelet-csr-approver:
  enabled: true
  namespace: kube-system

  chart:
    name: kubelet-csr-approver
    repo: https://postfinance.github.io/kubelet-csr-approver
    version: "{{ index .Versions.Charts "kubelet-csr-approver" }}"

  # IP prefixes allowed for kubelet serving certificates
  # Must include all node IPs in the cluster
  providerIpPrefixes:
    - "{{ .Values.NFS_SHARE_ALLOW.Value }}"

  # Regex pattern for valid node names (Talos generates names like talos-xxx-yyy)
  providerRegex: "^talos-[a-z0-9]{3}-[a-z0-9]{3}$"

  # Bypass DNS resolution check for SAN names (Talos node names aren't in DNS)
  bypassDnsResolution: true

  # Maximum certificate validity (365 days)
  maxExpirationSeconds: 31536000

  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 128Mi

# ============================================================================
# Cilium - CNI (Visibility Only - actual install via Talos inline)
# Sync Wave: 0
# ============================================================================

cilium:
  enabled: true
  chart:
    version: "{{ .Versions.Charts.cilium }}"  # Must match Taskfile cilium:render version

# ============================================================================
# Cilium LB IPAM - LoadBalancer IP Management + BGP
# Sync Wave: 1
# ============================================================================

cilium-lb-ipam:
  enabled: true

  lbipam:
    addresses:
      - "{{ .Values.LB_POOL_START.Value }}-{{ .Values.LB_POOL_END.Value }}"

  # Control Plane VIP - Only advertised by control-plane nodes
  # This creates a dedicated IP pool with restricted node selector
  controlPlaneVIP: "{{ .Values.CP_VIP.Value }}"

  bgp:
    enabled: true
    localASN: 64512
    peers:
      - name: "unifi-gateway"
        address: "{{ .Values.BGP_PEER_IP.Value }}"
        asn: 64513

# ============================================================================
# Democratic-CSI - NFS Storage Provisioner
# Sync Wave: 2
# ============================================================================

democratic-csi:
  enabled: true
  namespace: democratic-csi

  chart:
    name: democratic-csi
    repo: https://democratic-csi.github.io/charts/
    version: {{ index .Versions.Charts "democratic-csi" }}

  driver: freenas-api-nfs

  truenas:
    # Use IP address instead of hostname since internal DNS is not resolvable from cluster
    endpoint: https://{{ .Values.TRUENAS_IP.Value }}
    allowInsecure: true  # Required when using IP (no valid TLS cert for IP)
    apiKey: ""  # Populated from 1Password secret
    # 1Password vault path for TrueNAS API key (creates secret: truenas-api-key)
    onePasswordItemPath: {{ .Values.DEMOCRATIC_CSI_1P_PATH.Value }}

  nfs:
    shareHost: {{ .Values.TRUENAS_IP.Value }}
    shareAllow: {{ .Values.NFS_SHARE_ALLOW.Value }}
    parent: {{ .Values.TRUENAS_ZONE_PARENT.Value }}

  storageClasses:
    - name: {{ .Values.STORAGE_CLASS_NFS.Value }}
      defaultClass: true
      reclaimPolicy: Retain
      volumeBindingMode: Immediate
      allowVolumeExpansion: true
      parameters:
        fsType: nfs

  resources:
    controller:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi
    node:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi

