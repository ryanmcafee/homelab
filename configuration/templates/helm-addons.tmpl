# ============================================================================
# Tailscale Operator - Tailnet subnet router (homelab advertiser)
# Sync Wave: operator at 2, config (operator-oauth OnePasswordItem) at 1
# ============================================================================

tailscale-operator:
  enabled: true
  namespace: tailscale
  hostname: tailscale-operator-homelab

  chart:
    name: tailscale-operator
    repo: https://pkgs.tailscale.com/helmcharts
    version: "{{ index .Versions.Charts "tailscale-operator" }}"

  # 1Password vault path for the operator OAuth client (creates secret: operator-oauth)
  onePasswordItemPath: {{ .Values.TAILSCALE_OPERATOR_1P_PATH.Value }}

  # Connector subnet-router config — consumed by the Connector in Plan 03.
  # CIDR is PII, routed through the CMP config key (not a committed literal).
  connector:
    advertiseRoutes:
      - "{{ .Values.TAILSCALE_ADVERTISE_ROUTES.Value }}"
    tags:
      - "tag:k8s"

# ============================================================================
# Local Path Provisioner - Disabled for homelab (using democratic-csi)
# ============================================================================

local-path-provisioner:
  enabled: false

# ============================================================================
# 1Password Operator - Secret Management
# Sync Wave: 2
# ============================================================================

1password-operator:
  enabled: true
  namespace: onepassword-operator

  chart:
    name: connect
    repo: https://1password.github.io/connect-helm-charts
    version: {{ index .Versions.Charts "onepassword-connect" }}

  connect:
    credentialsJson: ""
    host: {{ .Values.OP_CONNECT_HOSTNAME.Value }}

  resources:
    operator:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi
    connect:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi

# ============================================================================
# CloudNativePG - PostgreSQL Operator
# Sync Wave: 2 (must be before home-assistant which depends on CNPG CRDs)
# ============================================================================

cloudnative-pg:
  enabled: true
  namespace: cnpg-system

  chart:
    name: cloudnative-pg
    repo: https://cloudnative-pg.github.io/charts
    version: {{ index .Versions.Charts "cloudnative-pg" }}

  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 500m
      memory: 512Mi

  monitoring:
    podMonitorEnabled: true
    grafanaDashboard:
      create: false

# ============================================================================
# Cert-Manager - TLS Certificate Management
# Sync Wave: 3
# ============================================================================

cert-manager:
  enabled: true
  namespace: cert-manager

  chart:
    name: cert-manager
    repo: https://charts.jetstack.io
    version: {{ index .Versions.Charts "cert-manager" }}

  installCRDs: true

  # Production Let's Encrypt
  letsencrypt:
    enabled: true
    email: {{ .Values.ACME_EMAIL.Value }}
    server: https://acme-v02.api.letsencrypt.org/directory

  cloudflare:
    enabled: true
    email: {{ .Values.ACME_EMAIL.Value }}
    apiToken: ""
    onePasswordItemPath: {{ .Values.CERT_MANAGER_1P_PATH.Value }}

  # DNS zones for certificate issuance
  dnsZones:
    - {{ .Values.DOMAIN.Value }}

  # Custom DNS resolvers for ACME DNS-01 challenge verification
  dns01RecursiveNameservers:
    - "1.1.1.1:53"
    - "8.8.8.8:53"
    - "8.8.4.4:53"

  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 200m
      memory: 256Mi

  webhook:
    resources:
      requests:
        cpu: 20m
        memory: 64Mi
      limits:
        cpu: 100m
        memory: 128Mi

  cainjector:
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi

# ============================================================================
# External-DNS - Automatic DNS Record Management
# Sync Wave: 4
# ============================================================================

external-dns:
  enabled: true
  namespace: external-dns

  chart:
    name: external-dns
    repo: https://kubernetes-sigs.github.io/external-dns/
    version: {{ index .Versions.Charts "external-dns" }}

  provider: cloudflare

  # Only watch ingress resources for Cloudflare DNS
  # CRD source has its own dedicated deployment (external-dns-cloudflare-crd)
  # Ingress class filtering (--ingress-class=external) is applied in the template
  # to ensure only external ingresses (e.g., Plex) publish to Cloudflare
  sources:
    - ingress

  cloudflare:
    apiToken: ""
    proxied: true
    onePasswordItemPath: {{ .Values.EXTERNAL_DNS_1P_PATH.Value }}

  domainFilters:
    - {{ .Values.DOMAIN.Value }}

  annotationFilter: external-dns.alpha.kubernetes.io/hostname

  # Default target for all DNS records - use DuckDNS for dynamic IP
  # This creates CNAME records pointing to the DDNS hostname
  defaultTarget: {{ .Values.EXTERNAL_DNS_DEFAULT_TARGET.Value }}

  resources:
    requests:
      cpu: 20m
      memory: 64Mi
    limits:
      cpu: 100m
      memory: 128Mi

# ============================================================================
# External-DNS UniFi - Internal DNS Management (Split DNS)
# Sync Wave: 4
# ============================================================================

external-dns-unifi:
  enabled: true
  namespace: external-dns-unifi

  chart:
    version: "{{ index .Versions.Charts "external-dns" }}"

  webhook:
    version: "{{ index .Versions.Charts "external-dns-webhook-unifi" }}"

  unifi:
    host: "https://{{ .Values.GATEWAY_IP.Value }}"

  # Uses existing UniFi credentials (needs api_key field added)
  onePasswordItemPath: {{ .Values.EXTERNAL_DNS_UNIFI_1P_PATH.Value }}

  domainFilters:
    - {{ .Values.DOMAIN.Value }}

  resources:
    requests:
      cpu: 20m
      memory: 64Mi
    limits:
      cpu: 100m
      memory: 128Mi

# ============================================================================
# Kube-Prometheus-Stack - Monitoring and Alerting
# Sync Wave: 5
# ============================================================================

kube-prometheus-stack:
  enabled: true
  namespace: monitoring

  chart:
    name: kube-prometheus-stack
    repo: https://prometheus-community.github.io/helm-charts
    version: {{ index .Versions.Charts "kube-prometheus-stack" }}

  prometheus:
    retention: 30d
    retentionSize: 50GB
    storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
    storageSize: 100Gi

    resources:
      requests:
        cpu: 500m
        memory: 2Gi
      limits:
        cpu: 2000m
        memory: 4Gi

    # Avoid scheduling on GPU nodes — keep GPU resources for media workloads
    affinity:
      nodeAffinity:
        requiredDuringSchedulingIgnoredDuringExecution:
          nodeSelectorTerms:
            - matchExpressions:
                - key: nvidia.com/gpu.present
                  operator: NotIn
                  values:
                    - "true"

    serviceMonitors:
      enabled: true

  grafana:
    enabled: true
    adminPassword: ""

    # Run as apps:users (568:100) to match NFS PVC permissions
    securityContext:
      runAsUser: {{ .Values.MEDIA_APP_UID.Value }}
      runAsGroup: {{ .Values.MEDIA_APP_GID.Value }}
      fsGroup: {{ .Values.MEDIA_APP_GID.Value }}

    persistence:
      enabled: true
      existingClaim: "{{ .Values.GRAFANA_CONFIG_PVC.Value }}"
      storageClass: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
      size: 10Gi

    ingress:
      enabled: true
      ingressClassName: {{ .Values.INGRESS_CLASS_INTERNAL.Value }}
      annotations:
        cert-manager.io/cluster-issuer: letsencrypt
        external-dns.alpha.kubernetes.io/hostname: {{ .Values.GRAFANA_HOSTNAME.Value }}
      hosts:
        - {{ .Values.GRAFANA_HOSTNAME.Value }}
      tls:
        - secretName: grafana-tls
          hosts:
            - {{ .Values.GRAFANA_HOSTNAME.Value }}

    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi

  alertmanager:
    enabled: true
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ .Values.STORAGE_CLASS_ISCSI.Value }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 10Gi

    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi

  nodeExporter:
    enabled: true
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 200m
        memory: 128Mi

  kubeStateMetrics:
    enabled: true
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi

# ============================================================================
# Traefik External - External Ingress Controller
# Sync Wave: 6
# ============================================================================

traefikExternal:
  enabled: true
  namespace: traefik

  chart:
    name: traefik
    repo: https://traefik.github.io/charts
    version: {{ .Versions.Charts.traefik }}

  service:
    type: LoadBalancer
    spec:
      externalTrafficPolicy: Cluster
    # Static IP for predictable port forwarding and DNS
    annotations:
      # Cilium LB IPAM annotation for static IP assignment
      io.cilium/lb-ipam-ips: "{{ .Values.TRAEFIK_STATIC_IP.Value }}"
      port-forwarding.{{ .Values.DOMAIN.Value }}/enable: "true"

  ports:
    web:
      port: 8000
      exposedPort: 80
      expose:
        default: true
      http:
        redirections:
          entryPoint:
            to: websecure
            scheme: https
            permanent: true
    websecure:
      port: 8443
      exposedPort: 443
      expose:
        default: true
      asDefault: true
      http:
        tls:
          enabled: true
      transport:
        respondingTimeouts:
          readTimeout: 0
          writeTimeout: 0
          idleTimeout: 600s
    traefik:
      port: 9000
      expose:
        default: true

  # Global arguments moved to additionalArguments in v39+
  additionalArguments:
    - --global.checknewversion=false
    - --global.sendanonymoususage=false

  # OIDC Plugin for authentication (replaces oauth2-proxy)
  experimental:
    plugins:
      traefikoidc:
        moduleName: github.com/lukaszraczylo/traefikoidc
        version: {{ index .Versions.Charts "traefik-oidc" }}

  # OIDC middleware configuration
  oidc:
    enabled: true
    providerURL: "{{ .Values.TRAEFIK_OIDC_PROVIDER_URL.Value }}"
    # Use path format - plugin constructs full URL from request host
    callbackURL: "/oauth2/callback"
    logoutURL: "/oauth2/logout"
    scopes:
      - openid
      - profile
      - email
    allowedDomains:
      - {{ .Values.TRAEFIK_OIDC_ALLOWED_DOMAINS.Value }}
    sessionEncryptionKeyPath: {{ .Values.TRAEFIK_OIDC_SESSION_KEY_PATH.Value }}
    googleOAuthPath: {{ .Values.TRAEFIK_GOOGLE_OAUTH_PATH.Value }}

  # Volume mounts for OIDC secrets
  volumes:
    - name: google-oauth-credentials
      mountPath: /etc/traefik/oidc/google
      type: secret
    - name: oidc-session-key
      mountPath: /etc/traefik/oidc/session
      type: secret

  env: []

  # Persistence disabled - ACME removed
  persistence:
    enabled: false

  ingressRoute:
    dashboard:
      enabled: true
      matchRule: Host(`{{ .Values.TRAEFIK_HOSTNAME.Value }}`)
      entryPoints: ["websecure"]
      tls:
        secretName: traefik-dashboard-tls

  resources:
    requests:
      cpu: 500m
      memory: 2Gi
    limits:
      cpu: 1000m
      memory: 2Gi

  deployment:
    replicas: 2

  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: kubernetes.io/hostname
      whenUnsatisfiable: DoNotSchedule
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: traefik
          app.kubernetes.io/instance: traefik-external

  autoscaling:
    enabled: true
    minReplicas: 2
    maxReplicas: 3
    metrics:
      - type: Resource
        resource:
          name: cpu
          target:
            type: Utilization
            averageUtilization: 80

  cloudflare:
    enabled: true
    onePasswordItemPath: {{ .Values.TRAEFIK_CLOUDFLARE_1P_PATH.Value }}

# ============================================================================
# Traefik Internal - Internal Ingress Controller
# Sync Wave: 6
# ============================================================================

traefikInternal:
  enabled: true
  namespace: traefik

  chart:
    name: traefik
    repo: https://traefik.github.io/charts
    version: {{ .Versions.Charts.traefik }}

  service:
    type: LoadBalancer
    spec:
