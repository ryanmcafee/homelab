  additionalArguments:
    - --global.checknewversion=false
    - --global.sendanonymoususage=false

  env: []

  persistence:
    enabled: false

  ingressRoute:
    dashboard:
      enabled: true
      matchRule: Host(`{{ .Values.TRAEFIK_INTERNAL_HOSTNAME.Value }}`)
      entryPoints: ["websecure"]
      tls:
        secretName: traefik-internal-dashboard-tls

  resources:
    requests:
