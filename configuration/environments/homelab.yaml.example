# ConfigSet "homelab" — production values.
# Copy to homelab.yaml and fill in real values.
# homelab.yaml is GITIGNORED — never commit it.

DOMAIN: replaceme-domain.com
# Optional local DNS zone; Terragrunt also publishes proxmox, k8s, truenas and nas A records under it
LOCAL_DNS_DOMAIN: ""
GATEWAY_IP: "198.51.100.1"
# The LAN the nodes sit on. Terragrunt builds the VM network from this; keep it
# separate from NFS_SHARE_ALLOW, which you may want to narrow.
LAN_CIDR: "198.51.100.0/24"
# Resolver the nodes are configured with — often the gateway, sometimes not.
DNS_SERVER_IP: "198.51.100.1"
TRUENAS_IP: "198.51.100.50"
TRUENAS_LAN_IP: "198.51.100.51/24"
PROXMOX_IP: "198.51.100.250"
IPMI_IP: "198.51.100.26"
CP_VIP: "198.51.100.10"
CP1_IP: "198.51.100.11"
CP2_IP: "198.51.100.12"
CP3_IP: "198.51.100.13"
WORKER1_IP: "198.51.100.21"
WORKER2_IP: "198.51.100.22"
WORKER3_IP: "198.51.100.23"
LB_POOL_START: "198.51.100.100"
LB_POOL_END: "198.51.100.200"
GATEWAY_EXTERNAL_STATIC_IP: "198.51.100.200"
# Pins the internal Gateway to an address (empty: Cilium LB IPAM picks one)
GATEWAY_INTERNAL_STATIC_IP: "198.51.100.101"
PLEX_LB_IP: "198.51.100.103"
# OpenTelemetry gateway collector (UniFi syslog/NetFlow target, otel.<DOMAIN>); a free address in the LB pool
OTEL_LB_IP: "198.51.100.104"
NFS_SHARE_ALLOW: "198.51.100.0/24"
# Extra CIDRs allowed to reach the collector, comma-separated: UniFi devices send syslog from their own addresses
OTEL_SOURCE_RANGES: "198.51.100.128/25"
# Homelab LAN CIDR advertised onto the tailnet by the Tailscale Connector subnet router
TAILSCALE_ADVERTISE_ROUTES: "198.51.100.0/24"
# Subnet names on the network flows dashboard (name=CIDR, comma-separated)
NETWORK_NAMES: "homelab=198.51.100.0/25,lan=198.51.100.128/25"
BGP_PEER_IP: "198.51.100.1"

# Cluster identity and the Proxmox node that hosts it.
CLUSTER_NAME: homelab
# `pvesh get /nodes` on your hypervisor. The Proxmox installer default is "pve".
PROXMOX_NODE: REPLACEME-proxmox-node
# YOUR fork. ArgoCD reconciles the cluster from this repository, so leaving the
# upstream URL here points your cluster at somebody else's git history.
GITOPS_REPO_URL: https://github.com/REPLACEME-user/homelab

NFS_MAPALL_USER: REPLACEME-username
ACME_EMAIL: admin@REPLACEME-domain.com
DUCKDNS_SUBDOMAIN: REPLACEME-subdomain
EXTERNAL_DNS_DEFAULT_TARGET: REPLACEME-subdomain.duckdns.org
PAPERCLIP_ADMIN_EMAIL: admin@REPLACEME-domain.com
# Optional: give the Paperclip agents your own Claude Code setup (settings, CLAUDE.md,
# hooks, plugins) from your dotfiles fork. Empty URL keeps the stock configuration.
PAPERCLIP_DOTFILES_REPO_URL: ""
# PAPERCLIP_DOTFILES_REF: main
# PAPERCLIP_DOTFILES_CLAUDE_DIR: claude
# PAPERCLIP_DOTFILES_PROFILE: personal
# PAPERCLIP_DOTFILES_SETUP_COMMAND: "bun claude/scripts/render-settings.ts"
# Private repository: a 1Password item whose GIT_TOKEN field can read it.
# PAPERCLIP_DOTFILES_1P_PATH: vaults/homelab/items/paperclip-dotfiles
# PAPERCLIP_MCP_CODESEARCH: "true"
# Another codesearch repository than the default (versions.yaml tools.codesearch pins that one):
# PAPERCLIP_CODESEARCH_REPO: https://github.com/<owner>/codesearch
# PAPERCLIP_CODESEARCH_VERSION: v1.6.1

# GPU
GPU_VENDOR: "intel"
