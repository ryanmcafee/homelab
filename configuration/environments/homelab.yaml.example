# ConfigSet "homelab" — production values.
# Copy to homelab.yaml and fill in real values.
# homelab.yaml is GITIGNORED — never commit it.

DOMAIN: REPLACEME-domain.com
GATEWAY_IP: "192.168.1.1"
TRUENAS_IP: "192.168.1.100"
TRUENAS_LAN_IP: "192.168.1.150/24"
PROXMOX_IP: "192.168.1.250"
IPMI_IP: "192.168.1.26"
CP_VIP: "192.168.1.10"
CP1_IP: "192.168.1.11"
CP2_IP: "192.168.1.12"
CP3_IP: "192.168.1.13"
WORKER1_IP: "192.168.1.21"
WORKER2_IP: "192.168.1.22"
WORKER3_IP: "192.168.1.23"
LB_POOL_START: "192.168.1.100"
LB_POOL_END: "192.168.1.200"
TRAEFIK_STATIC_IP: "192.168.1.200"
PLEX_LB_IP: "192.168.1.103"
# OpenTelemetry gateway collector (UniFi syslog/NetFlow target, otel.<DOMAIN>); a free address in the LB pool
OTEL_LB_IP: "192.168.1.104"
NFS_SHARE_ALLOW: "192.168.1.0/24"
# Extra CIDRs allowed to reach the collector, comma-separated: UniFi devices send syslog from their own addresses
OTEL_SOURCE_RANGES: "192.168.0.0/24"
# Homelab LAN CIDR advertised onto the tailnet by the Tailscale Connector subnet router
TAILSCALE_ADVERTISE_ROUTES: "192.168.1.0/24"
# Subnet names on the network flows dashboard (name=CIDR, comma-separated)
NETWORK_NAMES: "homelab=192.168.1.0/25,lan=192.168.1.128/25"
BGP_PEER_IP: "192.168.1.1"
NFS_MAPALL_USER: REPLACEME-username
ACME_EMAIL: admin@REPLACEME-domain.com
TRAEFIK_OIDC_ALLOWED_DOMAINS: REPLACEME-domain.com
DUCKDNS_SUBDOMAIN: REPLACEME-subdomain
EXTERNAL_DNS_DEFAULT_TARGET: REPLACEME-subdomain.duckdns.org
PAPERCLIP_ADMIN_EMAIL: admin@REPLACEME-domain.com

# GPU
GPU_VENDOR: "intel"
