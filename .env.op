# 1Password Secret References for op run
# Usage: op run --env-file=.env.op -- terragrunt apply
#
# This file contains 1Password secret references (op://) that get resolved
# at runtime by `op run`. Secrets are only available for the command duration.

# =============================================================================
# 1Password Configuration
# =============================================================================
# NOTE: OP_CONNECT_HOST and OP_CONNECT_TOKEN are intentionally NOT set here.
# The onepassword_item resource uses `op item create` which doesn't work with
# Connect mode. Using service_account_token instead, which supports both
# reading and creating items.

# 1Password Operator bootstrap credentials (for gitops-bootstrap module)
# Store the credentials JSON content in 1Password as a text field
TF_VAR_onepassword_credentials_json=op://homelab/onepassword-connect/1password-credentials.json
TF_VAR_onepassword_service_account_token=op://homelab/onepassword-connect/service_account_token

# 1Password Connect token (for operator to authenticate with Connect server)
OP_CONNECT_TOKEN=op://homelab/onepassword-connect/connect_token

# 1Password vault ID for storing kubeconfig/talosconfig
TF_VAR_onepassword_vault_id=op://homelab/onepassword-connect/vault_id

# =============================================================================
# Proxmox Configuration
# =============================================================================
TF_VAR_proxmox_api_url=op://homelab/proxmox/api_url
TF_VAR_proxmox_api_token_id=op://homelab/proxmox/api_token_id
TF_VAR_proxmox_api_token_secret=op://homelab/proxmox/api_token_secret
TF_VAR_proxmox_node=op://homelab/proxmox/node

# =============================================================================
# TrueNAS Configuration
# =============================================================================
TF_VAR_truenas_api_key=op://homelab/truenas/api_key
TF_VAR_truenas_host=op://homelab/truenas/host
TRUENAS_ADMIN_PASSWORD=op://homelab/truenas/admin_password
CLOUDFLARE_API_TOKEN=op://homelab/cloudflare/api_token

# =============================================================================
# Ansible Configuration
# =============================================================================
ANSIBLE_VAULT_PASSWORD=op://homelab/ansible/vault_password

# =============================================================================
# Network Configuration
# =============================================================================
TF_VAR_base_fqdn=op://homelab/network-config/base_fqdn
TF_VAR_cloudflare_api_token=op://homelab/cloudflare/api_token
TF_VAR_cloudflare_zone_id=op://homelab/cloudflare/zone_id

# =============================================================================
# Kubernetes Configuration
# =============================================================================
TF_VAR_cluster_name=op://homelab/network-config/cluster_name
TF_VAR_environment=op://homelab/network-config/environment

# =============================================================================
# UniFi Configuration
# =============================================================================
UNIFI_API=op://homelab/unifi/api_url
UNIFI_USERNAME=op://homelab/unifi/username
UNIFI_PASSWORD=op://homelab/unifi/password
UNIFI_SITE=op://homelab/unifi/site
