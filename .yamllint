---
extends: default

# Ignore Helm template directories as they contain Go templates
ignore: |
  charts/*/templates/
  charts/*/charts/

rules:
  line-length:
    max: 120
    level: warning
  document-start:
    level: warning
  truthy:
    allowed-values: ['true', 'false', 'on', 'off']
    level: warning
  braces:
    level: warning
