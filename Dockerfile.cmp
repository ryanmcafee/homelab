# Build stage — compile homelab CLI
FROM golang:1.19-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /homelab ./cmd/homelab

# Runtime stage — minimal image for CMP sidecar
FROM alpine:3.20

# Install helm
RUN apk add --no-cache helm

# Copy homelab CLI binary
COPY --from=builder /homelab /usr/local/bin/homelab

# Copy plugin configuration
COPY cmp/plugin.yaml /home/argocd/cmp-server/config/plugin.yaml

# Run as non-root user
USER 999

ENTRYPOINT ["/var/run/argocd/argocd-cmp-server"]
