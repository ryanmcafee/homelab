# ksops stage — extract binaries from distroless image
# renovate: datasource=docker depName=viaductoss/ksops
FROM viaductoss/ksops:v4.4.0 AS ksops

# Build stage — compile homelab CLI
FROM golang:1.26-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /homelab ./cmd/homelab

# Runtime stage — minimal image for CMP sidecar
FROM alpine:3.23

# Install helm
RUN apk add --no-cache helm

# Copy homelab CLI binary
COPY --from=builder /homelab /usr/local/bin/homelab

# Copy ksops binaries (extracted at build time from distroless image)
COPY --from=ksops /usr/local/bin/ksops /usr/local/bin/ksops
COPY --from=ksops /usr/local/bin/kustomize /usr/local/bin/kustomize

# Copy plugin configuration
COPY cmp/plugin.yaml /home/argocd/cmp-server/config/plugin.yaml

# Run as non-root user
USER 999

ENTRYPOINT ["/var/run/argocd/argocd-cmp-server"]
