# Terraform / Terragrunt
.terraform/
.terraform.d/
.terragrunt-cache/
*.tfstate
*.tfstate.backup
*.tfplan
*.tfvars
!terraform.tfvars.example
.terraform.lock.hcl

# Ansible
*.retry
.vault_password
ansible/inventory/hosts.yml
ansible/group_vars/all.yml

# Local environment
.env
.envrc
!.envrc.example
!.env.op
.direnv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets
secrets/
# Allow SOPS-encrypted secrets in charts/secrets
!charts/secrets/
# Ignore unencrypted secrets (only commit *.sops.yaml)
charts/secrets/**/*.yaml
!charts/secrets/**/*.sops.yaml
!charts/secrets/**/kustomization.yaml
!charts/secrets/**/secret-generator.yaml
*.key
*.pem
*.crt
!*.example

# Tilt
.tilt-cache/

# Task
.task/

# Temporary files
tmp/
*.tmp
*.log

# Generated/rendered files (stored in 1Password for cross-machine consistency)
*-rendered.yaml
terragrunt/files/*.yaml

# Kubeconfig
kubeconfig
*.kubeconfig

# Talosconfig
talosconfig

# 1Password
.op/

# Beads/bd
.beads/db/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal

# Claude (ignore local settings, allow shared commands and skills)
.claude/*
!.claude/commands/
!.claude/skills/

# mise
.mise.local.toml
.mise/

# Claude local config (contains PII like IP addresses)
CLAUDE.local.md

# GSD planning workspace (codebase map and plans contain raw PII like IPs/hostnames)
.planning/

# Terraform state lock files
terragrunt/terraform.tfstate.d/**/.terraform.tfstate.lock.info

# Packer
*.iso
*.iso.lock

# Go binaries
/homelab
/bin/homelab*
/cmd/homelab/homelab
/cmd/homelab/homelab.exe

# Configuration - environment-specific values contain PII
configuration/environments/homelab.yaml
configuration/environments/staging.yaml
!configuration/environments/defaults.yaml
!configuration/environments/localdev.yaml
!configuration/environments/*.example

# Generated outputs (produced by `homelab config export`)
*.generated.yaml
*.generated.tfvars
*.generated.yml
.env.generated
configuration/resolved.json

# Environment-specific Helm values (contain PII — generated at runtime by CMP)
charts/addons/values-homelab.yaml
charts/addons/values-homelab.generated.yaml
charts/applications/values-homelab.yaml
charts/applications/values-homelab.generated.yaml
charts/*-config/values-homelab.yaml

/policy.hujson

# PII audit (replaced by living schema docs)
PII.md
.serena/project.yml
.serena/project.yml
