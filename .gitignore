.env
.envrc
!.envrc.example
!.env.op
.direnv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets
secrets/
# Allow SOPS-encrypted secrets in charts/secrets
!charts/secrets/
# Ignore unencrypted secrets (only commit *.sops.yaml)
charts/secrets/**/*.yaml
!charts/secrets/**/*.sops.yaml
!charts/secrets/**/kustomization.yaml
!charts/secrets/**/secret-generator.yaml
*.key
*.pem
*.crt
!*.example

# Tilt
.tilt-cache/

# Task
.task/

# Temporary files
tmp/
*.tmp
*.log

# Generated/rendered files (may contain secrets)
*-rendered.yaml
terragrunt/files/*.yaml

# Kubeconfig
kubeconfig
*.kubeconfig

# Talosconfig
talosconfig

# 1Password
.op/

# Beads/bd
.beads/db/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal

# Claude
.claude/

# mise
.mise.local.toml
.mise/

# Terraform state lock files
terragrunt/terraform.tfstate.d/**/.terraform.tfstate.lock.info

