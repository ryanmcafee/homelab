# Terraform / Terragrunt
.terraform/
.terraform.d/
.terragrunt-cache/
*.tfstate
*.tfstate.backup
*.tfplan
*.tfvars
!terraform.tfvars.example
.terraform.lock.hcl

# Ansible
*.retry
.vault_password
ansible/inventory/hosts.yml
ansible/group_vars/all.yml

