! FRRouting BGP Configuration
! Generated by Terraform - Do not edit manually
!
frr defaults traditional
log syslog informational
!
router bgp ${local_as}
 bgp router-id ${router_id}
%{ if log_neighbor_changes ~}
 bgp log-neighbor-changes
%{ endif ~}
 no bgp ebgp-requires-policy
 no bgp network import-check
 !
%{ for neighbor in neighbors ~}
 ! Neighbor: ${neighbor.description}
 neighbor ${neighbor.address} remote-as ${neighbor.remote_as}
 neighbor ${neighbor.address} description ${neighbor.description}
%{ if neighbor.password != null ~}
 neighbor ${neighbor.address} password ${neighbor.password}
%{ endif ~}
%{ endfor ~}
 !
 address-family ipv4 unicast
%{ for neighbor in neighbors ~}
  neighbor ${neighbor.address} activate
  neighbor ${neighbor.address} soft-reconfiguration inbound
%{ endfor ~}
%{ for network in networks ~}
  network ${network}
%{ endfor ~}
 exit-address-family
!
line vty
!
